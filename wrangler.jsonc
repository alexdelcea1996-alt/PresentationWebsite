{
  // Deploy configuration for Cloudflare Workers.
  //
  // Without this file the site builds on every push and then never ships: the
  // Workers Builds deploy step runs `npx wrangler deploy`, which has nothing to
  // read and fails, leaving whatever was published last frozen in place. The
  // build log looks healthy right up to the last line, so the symptom is a site
  // that quietly stops keeping up with the repository.
  //
  // `name` has to stay exactly this — it is the worker being updated, and the
  // first half of presentationwebsite.alexdelcea1996.workers.dev. A different
  // value here creates a second worker at a second address instead.
  "name": "presentationwebsite",
  "compatibility_date": "2026-08-01",

  // --- Moving to a custom domain ---------------------------------------------
  //
  // Left commented on purpose. The order matters and getting it wrong takes the
  // site offline rather than moving it.
  //
  //   1. Point the domain's nameservers at Cloudflare and let the zone go
  //      active. Nothing here changes yet.
  //   2. Add the route below and deploy. The site now answers on both the
  //      custom domain and the workers.dev address.
  //   3. Set SITE_URL to the new origin in the Workers Builds settings and
  //      redeploy, so canonicals, hreflang, og:url, the sitemap, security.txt
  //      and the case-study link all move with it. Nothing in the repository
  //      needs editing for this — `tests/suites/completeness.mjs` fails the
  //      build if a hostname ever gets typed into a source file again.
  //   4. Only once the custom domain is confirmed serving, set
  //      "workers_dev": false to retire the old address.
  //
  // Doing step 4 before step 2 leaves the worker with no address at all.
  //
  // "routes": [{ "pattern": "example.ro", "custom_domain": true }],
  // "workers_dev": false,

  "assets": {
    // `npm run build` writes here, including `_headers` — Workers static assets
    // reads that file, which is what puts the CSP and the cache rules in front
    // of the pages.
    "directory": "./dist",

    // Unknown addresses get the designed 404 page with a real 404 status,
    // rather than Cloudflare's default one.
    "not_found_handling": "404-page"
  }
}
