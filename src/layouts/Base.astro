---
import { Font } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { getContent, localeTags, locales, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  /** Overrides the site-wide title. Sub-pages pass their own. */
  title?: string;
  description?: string;
  /**
   * Per-locale URLs of this same page, for the hreflang links. Defaults to the
   * home page of each language, which is right for the landing page only.
   */
  alternates?: Partial<Record<Locale, string>>;
  /** "article" for blog posts; the default suits every other page. */
  ogType?: 'website' | 'article';
  /** Extra JSON-LD emitted alongside the site-wide business schema. */
  extraSchema?: unknown;
  /** Path to an RSS feed to advertise for this page. */
  feed?: string;
}

const {
  locale,
  title,
  description,
  alternates: alternateOverrides,
  ogType = 'website',
  extraSchema,
  feed,
} = Astro.props;
const t = getContent(locale);

const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;

const canonical = new URL(Astro.url.pathname, Astro.site);
/** Join the configured `base` with a file in `public/`, collapsing double slashes. */
const asset = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/{2,}/g, '/');

const ogImage = new URL(asset(locale === 'en' ? 'og-image-en.png' : 'og-image.png'), Astro.site);
const faviconHref = asset('favicon.svg');

// One <link rel="alternate"> per language, plus x-default pointing at Romanian.
const alternates = locales
  .filter((code) => !alternateOverrides || code in alternateOverrides)
  .map((code) => ({
    code,
    tag: localeTags[code],
    href: new URL(alternateOverrides?.[code] ?? getRelativeLocaleUrl(code), Astro.site).href,
  }));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: pageDescription,
  url: canonical.href,
  email: `mailto:${site.email}`,
  areaServed: site.areaServed,
  address: { '@type': 'PostalAddress', addressCountry: 'RO', addressLocality: site.locality },
  knowsLanguage: ['ro', 'en'],
  serviceType: t.services.items.map((service) => service.title),
  ...(site.phone ? { telephone: site.phone } : {}),
  ...(site.social.github || site.social.linkedin
    ? { sameAs: [site.social.github, site.social.linkedin].filter(Boolean) }
    : {}),
};
---

<!doctype html>
<html lang={localeTags[locale]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.tag} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={localeTags[locale].replace('-', '_')} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.href} />

    <meta name="theme-color" content="#0b0f1a" />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />

    <Font cssVariable="--ff-display" preload />
    <Font cssVariable="--ff-body" preload />

    <script is:inline set:html={JSON.stringify(structuredData)} type="application/ld+json" />
    {
      extraSchema && (
        <script is:inline set:html={JSON.stringify(extraSchema)} type="application/ld+json" />
      )
    }
    {feed && <link rel="alternate" type="application/rss+xml" title={pageTitle} href={feed} />}

    {/* Runs before first paint: flags JS availability so reveal animations never
        hide content for no-JS readers, and resolves the theme so the page never
        flashes the wrong palette. Stored choice wins over the OS setting. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Private mode or blocked storage: fall through to the OS preference.
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
        if (theme === 'light') {
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', '#ffffff');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-surface-hover focus:px-4 focus:py-2 focus:text-fg"
    >
      {t.nav.skipToContent}
    </a>

    <slot />

    <script>
      // Reveal-on-scroll. One observer for the whole page, unobserving as it goes.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.style.transitionDelay = `${el.dataset.revealDelay ?? 0}ms`;
              el.classList.add('is-visible');
              observer.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
