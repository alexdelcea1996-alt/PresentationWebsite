---
import { Font } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { getContent, localeTags, locales, type Locale } from '../i18n';
import { site, telHref } from '../data/site';
import { projectTypes } from '../data/configurator';

interface Props {
  locale: Locale;
  /** Overrides the site-wide title. Sub-pages pass their own. */
  title?: string;
  description?: string;
  /**
   * Per-locale URLs of this same page, for the hreflang links. Defaults to the
   * home page of each language, which is right for the landing page only.
   */
  alternates?: Partial<Record<Locale, string>>;
  /** "article" for blog posts; the default suits every other page. */
  ogType?: 'website' | 'article';
  /** Extra JSON-LD emitted alongside the site-wide business schema. */
  extraSchema?: unknown;
  /** Path to an RSS feed to advertise for this page. */
  feed?: string;
  /**
   * Trail from the home page to here, excluding both ends: the home crumb is
   * added below and the current page is the last item. Pages that sit directly
   * under the root pass nothing.
   */
  breadcrumb?: { name: string; href: string }[];
  /** Keeps the page out of search results — the 404 has nothing to rank for. */
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  alternates: alternateOverrides,
  ogType = 'website',
  extraSchema,
  feed,
  breadcrumb,
  noindex = false,
} = Astro.props;
const t = getContent(locale);

const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;

const canonical = new URL(Astro.url.pathname, Astro.site);
/** Join the configured `base` with a file in `public/`, collapsing double slashes. */
const asset = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/{2,}/g, '/');

/**
 * One share image per page, carrying that page's own title. The file is drawn
 * after the build by `scripts/generate-og-images.mjs`, which reads this very
 * URL back out of the HTML — so the path is declared in exactly one place and
 * the two cannot drift.
 */
const ogSlug = canonical.pathname.replace(/^\/+|\/+$/g, '').replace(/\//g, '-') || 'home';
const ogImage = new URL(asset(`og/${ogSlug}.png`), Astro.site);
const faviconHref = asset('favicon.svg');

// One <link rel="alternate"> per language, plus x-default pointing at Romanian.
const alternates = locales
  .filter((code) => !alternateOverrides || code in alternateOverrides)
  .map((code) => ({
    code,
    tag: localeTags[code],
    href: new URL(alternateOverrides?.[code] ?? getRelativeLocaleUrl(code), Astro.site).href,
  }));

/**
 * The business, declared identically on every page.
 *
 * It used to carry `url: canonical.href` and no `@id`, which described twenty-odd
 * separate businesses that happened to share a name — one per address. The whole
 * node still repeats on every page (a bare `@id` reference is not resolved across
 * documents), but now it always points at the same identifier and the same URL,
 * so it reads as one entity seen many times.
 */
// One identifier and one address for the business. Pointing `url` at the current
// locale's home would put two addresses under a single `@id`, which contradicts
// itself; the language versions are already expressed through hreflang. Derived
// from the default locale rather than hardcoded, so it follows `x-default`.
const businessId = new URL('#business', Astro.site).href;
const businessUrl = new URL(getRelativeLocaleUrl(locales[0]), Astro.site).href;

// Ascending, to line up with the pricing cards — which the `offers` suite
// already asserts are ordered cheapest to dearest.
const offerFloors = projectTypes.map((type) => type.basePrice).sort((a, b) => a - b);

const isHome = canonical.pathname === getRelativeLocaleUrl(locale);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': businessId,
  name: site.name,
  description: pageDescription,
  url: businessUrl,
  email: `mailto:${site.email}`,
  areaServed: site.areaServed,
  address: { '@type': 'PostalAddress', addressCountry: 'RO', addressLocality: site.locality },
  knowsLanguage: ['ro', 'en'],
  serviceType: t.services.items.map((service) => service.title),
  // Dialable form, not the display form — this one is read by machines.
  ...(site.phone ? { telephone: telHref().replace('tel:', '') } : {}),
  ...(site.social.github || site.social.linkedin
    ? { sameAs: [site.social.github, site.social.linkedin].filter(Boolean) }
    : {}),
  // What the packages cost, in a form a machine can read. Every price on the
  // site is "from X", so these are minimum prices — a flat `price` would assert
  // a fixed figure that is not on offer. The numbers come from the configurator
  // rather than from the copy, so there is no second place to keep them right.
  //
  // Only on the landing page: that is where the prices are actually shown, and
  // repeating the whole catalogue on a blog post would be noise on 24 pages.
  ...(isHome ? { hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t.pricing.title,
    itemListElement: t.pricing.plans.map((plan, index) => ({
      '@type': 'Offer',
      name: plan.name,
      description: plan.description,
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: offerFloors[index] ?? null,
        priceCurrency: 'EUR',
        valueAddedTaxIncluded: false,
      },
    })),
  } } : {}),
};

/**
 * Home → … → this page. Only emitted when a page passes a trail, and only with
 * crumbs that are real addresses — there is no `/servicii/` index, so a service
 * page is two levels, not three.
 */
const breadcrumbSchema = breadcrumb?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: t.nav.home, href: getRelativeLocaleUrl(locale) },
        ...breadcrumb,
      ].map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.href, Astro.site).href,
      })),
    }
  : null;
---

<!doctype html>
<html lang={localeTags[locale]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* A 404 is served under every wrong address there is, so a canonical or an
        hreflang pair would be claiming things about URLs that do not exist. */}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical.href} />
          {alternates.map((alt) => (
            <link rel="alternate" hreflang={alt.tag} href={alt.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />
        </>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={localeTags[locale].replace('-', '_')} />
    {
      alternates
        .filter((alt) => alt.code !== locale)
        .map((alt) => (
          <meta property="og:locale:alternate" content={alt.tag.replace('-', '_')} />
        ))
    }
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.href} />

    <meta name="theme-color" content="#0b0f1a" />
    {/* SVG first for anything modern; the PNG is there for what is not. */}
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />

    <Font cssVariable="--ff-display" preload />
    <Font cssVariable="--ff-body" preload />

    <script is:inline set:html={JSON.stringify(structuredData)} type="application/ld+json" />
    {
      breadcrumbSchema && (
        <script is:inline set:html={JSON.stringify(breadcrumbSchema)} type="application/ld+json" />
      )
    }
    {
      extraSchema && (
        <script is:inline set:html={JSON.stringify(extraSchema)} type="application/ld+json" />
      )
    }
    {feed && <link rel="alternate" type="application/rss+xml" title={pageTitle} href={feed} />}

    {/* Runs before first paint: flags JS availability so reveal animations never
        hide content for no-JS readers, and resolves the theme so the page never
        flashes the wrong palette. Stored choice wins over the OS setting. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Private mode or blocked storage: fall through to the OS preference.
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
        if (theme === 'light') {
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', '#ffffff');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-surface-hover focus:px-4 focus:py-2 focus:text-fg"
    >
      {t.nav.skipToContent}
    </a>

    <slot />

    <script>
      // Reveal-on-scroll. One observer for the whole page, unobserving as it goes.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.style.transitionDelay = `${el.dataset.revealDelay ?? 0}ms`;
              el.classList.add('is-visible');
              observer.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
