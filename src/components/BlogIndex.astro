---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { getContent, localeTags, type Locale } from '../i18n';
import { blogIndexPath, formatDate, getPosts, postPath, readingMinutes } from '../data/blog';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const posts = await getPosts(locale);
const localeTag = localeTags[locale];

// Both languages have their own index, so hreflang points at each.
const alternates = { ro: blogIndexPath('ro'), en: blogIndexPath('en') };
const feedPath = `${import.meta.env.BASE_URL}/${locale === 'en' ? 'en/rss.xml' : 'rss.xml'}`.replace(
  /\/{2,}/g,
  '/',
);
---

<Base
  locale={locale}
  title={t.blog.metaTitle}
  description={t.blog.metaDescription}
  alternates={alternates}
  feed={feedPath}
>
  <Header locale={locale} />

  <main id="main">
    <section class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-24">
      <div
        class="glow left-1/2 top-[-6rem] size-[34rem] -translate-x-1/2 bg-accent/18"
        aria-hidden="true"
      >
      </div>

      <div class="container-page">
        <div class="max-w-2xl">
          <p class="eyebrow">{t.blog.eyebrow}</p>
          <h1 class="mt-4 text-3xl font-semibold sm:text-4xl md:text-5xl md:leading-[1.1]">
            {t.blog.title}
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-fg-muted">{t.blog.subtitle}</p>

          <a
            href={feedPath}
            class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-fg-subtle transition-colors hover:text-accent-alt"
          >
            <Icon name="rss" class="size-4" />
            {t.blog.rssLabel}
          </a>
        </div>

        {
          posts.length > 0 ? (
            <div class="mt-16 grid gap-6 lg:grid-cols-2">
              {posts.map((post, index) => (
                <article
                  class="card card-hover flex flex-col"
                  data-reveal
                  data-reveal-delay={index * 60}
                >
                  <div class="flex items-center gap-3 text-xs text-fg-subtle">
                    <span class="eyebrow text-xs">{post.data.category}</span>
                    <span aria-hidden="true">·</span>
                    <time datetime={post.data.publishedAt.toISOString()}>
                      {formatDate(post.data.publishedAt, localeTag)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>
                      {readingMinutes(post.body)} {t.blog.readingSuffix}
                    </span>
                  </div>

                  <h2 class="mt-4 text-xl font-semibold">
                    <a
                      href={postPath(locale, post.data.urlSlug)}
                      class="after:absolute after:inset-0 hover:text-accent-alt"
                    >
                      {post.data.title}
                    </a>
                  </h2>

                  <p class="mt-3 grow text-sm leading-relaxed text-fg-muted">
                    {post.data.description}
                  </p>
                </article>
              ))}
            </div>
          ) : (
            <p class="card-placeholder mt-16 text-center">{t.blog.empty}</p>
          )
        }
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>
