---
import Blueprint from './Blueprint.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getContent, type Locale } from '../i18n';
import { site, telHref, whatsappHref } from '../data/site';
import { blogIndexPath } from '../data/blog';
import { colophonPath, checklistPath, contactPath, demoPath } from '../data/demo';
import { estimatePath, pricingPath, projectsPath, servicesIndexPath } from '../data/pages';
import { build } from '../data/build';
import { getLegalPage, legalPath } from '../data/legal';

interface Props {
  locale: Locale;
  /**
   * Renders the "see the construction" control beside the provenance line.
   * Off by default: the drawing is worth having on the two pages that argue
   * about how the site is built, and would be clutter on the other forty-seven.
   */
  blueprint?: boolean;
}

const { locale, blueprint = false } = Astro.props;
const t = getContent(locale);
const year = new Date().getFullYear();
const privacy = await getLegalPage(locale, 'privacy');
const privacyHref = legalPath(locale, privacy.data.urlSlug);
// Anchors are absolute so they also work from case-study pages.

const links = [
  { href: servicesIndexPath(locale), label: t.nav.services },
  { href: `${servicesIndexPath(locale)}#process`, label: t.nav.process },
  { href: projectsPath(locale), label: t.nav.portfolio },
  { href: pricingPath(locale), label: t.nav.pricing },
  { href: estimatePath(locale), label: t.nav.estimate },
  { href: demoPath(locale), label: t.nav.demo },
  { href: blogIndexPath(locale), label: t.nav.blog },
  { href: contactPath(locale, undefined, 'footer'), label: t.nav.contact },
  { href: checklistPath(locale), label: t.checklist.eyebrow },
  { href: colophonPath(locale), label: t.colophon.eyebrow },
];

// One list for every way of reaching Alex. Entries with an empty href are
// dropped, so an unset phone or social profile simply does not appear.
// WhatsApp carries a call to action rather than the number: the number is
// already on the line above it, and repeating it reads like a mistake.
const contacts = [
  { href: `mailto:${site.email}`, label: site.email, external: false },
  { href: telHref(), label: site.phone, external: false },
  { href: whatsappHref(t.contact.whatsappMessage), label: t.contact.whatsappAction, external: true },
  { href: site.social.github, label: 'GitHub', external: true },
  { href: site.social.linkedin, label: 'LinkedIn', external: true },
].filter((contact) => contact.href);
---

<footer class="border-t border-border bg-surface-deep/60 py-14">
  <div class="container-page">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr]">
      <div>
        <a
          href={getRelativeLocaleUrl(locale)}
          class="flex w-fit items-center gap-2.5 font-display text-base font-semibold"
        >
          <span
            class="grid size-8 place-items-center rounded-lg bg-linear-110 from-accent to-accent-alt text-on-accent"
          >
            <Icon name="spark" class="size-4" />
          </span>
          <span class="text-fg">{site.name}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-fg-muted">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.nav}>
        <h2 class="font-display text-sm font-semibold text-fg">{t.footer.nav}</h2>
        <ul class="mt-4 space-y-2.5">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-fg-muted transition-colors hover:text-accent-alt"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-display text-sm font-semibold text-fg">{t.nav.contact}</h2>
        <ul class="mt-4 space-y-2.5">
          {
            contacts.map((contact) => (
              <li>
                <a
                  href={contact.href}
                  target={contact.external ? '_blank' : undefined}
                  rel={contact.external ? 'noopener noreferrer' : undefined}
                  class="text-sm text-fg-muted transition-colors hover:text-accent-alt"
                >
                  {contact.label}
                </a>
              </li>
            ))
          }
        </ul>

        <LanguageSwitcher locale={locale} class="mt-6 w-fit" />
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-border pt-6 text-xs text-fg-subtle sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {year} {site.name}. {t.footer.rights}{' '}
        <a href={privacyHref} class="underline underline-offset-4 transition-colors hover:text-accent-alt">
          {t.legal.privacyLink}
        </a>
      </p>
      {/*
        Provenance. "Built with Astro" was a statement of taste; adding the
        commit makes it a statement of fact somebody can check — and the link
        goes to the page that explains what else can and cannot be checked.
      */}
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <span>{t.footer.builtWith}</span>
        {
          build.shortCommit && (
            <span>
              {t.footer.builtFrom}{' '}
              <a
                href={colophonPath(locale)}
                class="font-mono underline underline-offset-4 transition-colors hover:text-accent-alt"
                data-provenance
              >
                {build.shortCommit}
              </a>
            </span>
          )
        }
      </p>
      {blueprint && <Blueprint locale={locale} />}
    </div>
  </div>
</footer>
