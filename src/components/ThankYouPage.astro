---
/**
 * Where a real submission lands.
 *
 * Only reachable after Web3Forms confirms delivery — the mailto path cannot
 * know whether anything was sent, so it keeps its own rescue panel instead of
 * being redirected here. A thank-you page that a failed send can reach is the
 * same false success this site just spent a commit removing.
 *
 * The second conversion is the point of the page existing at all: somebody who
 * has just written is the most willing they will ever be to also book the
 * call. Everything else here restates promises already published.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import BookingCard from './BookingCard.astro';
import { getContent, locales, type Locale } from '../i18n';
import { site } from '../data/site';
import { thankYouPath } from '../data/demo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).thankYou;

const alternates = Object.fromEntries(
  locales.map((code) => [code, thankYouPath(code)]),
) as Partial<Record<Locale, string>>;
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternates}
  noindex
>
  <Header locale={locale} />

  <main id="main" class="relative overflow-hidden">
    <div
      class="glow left-1/2 top-[-6rem] size-[32rem] -translate-x-1/2 bg-accent/18"
      aria-hidden="true"
    >
    </div>

    <div class="container-page py-32 sm:py-40">
      <div class="mx-auto max-w-2xl">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="mt-4 text-3xl font-semibold sm:text-4xl md:text-5xl md:leading-[1.1]">
          {t.title}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-fg-muted">{t.lead}</p>

        <h2 class="mt-14 font-display text-lg font-semibold">{t.stepsTitle}</h2>
        <ol class="mt-5 space-y-4">
          {
            t.steps.map((step, index) => (
              <li class="flex items-start gap-3" data-thanks-step>
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-accent/10 font-display text-xs font-semibold text-accent-alt">
                  {index + 1}
                </span>
                <span class="text-sm leading-relaxed text-fg-muted">{step}</span>
              </li>
            ))
          }
        </ol>

        {
          site.calLink && (
            <div class="card mt-12" data-thanks-booking>
              <h2 class="font-display text-lg font-semibold">{t.bookTitle}</h2>
              <p class="mt-3 text-sm leading-relaxed text-fg-muted">{t.bookBody}</p>
              <BookingCard locale={locale} />
            </div>
          )
        }

        <a
          href={getRelativeLocaleUrl(locale)}
          class="mt-12 inline-flex items-center gap-2 text-sm font-medium text-fg-muted transition-colors hover:text-accent-alt"
        >
          <Icon name="arrow-right" class="size-4 rotate-180" />
          {t.back}
        </a>
      </div>
    </div>
  </main>

  <Footer locale={locale} />
</Base>
