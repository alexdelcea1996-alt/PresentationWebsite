---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, subtitle, align = 'center' } = Astro.props;
const centered = align === 'center';
---

<div
  class:list={[
    'max-w-2xl',
    centered ? 'mx-auto text-center' : '',
  ]}
  data-reveal
>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-4 text-3xl font-semibold sm:text-4xl md:text-[2.75rem] md:leading-[1.1]">
    {title}
  </h2>
  {subtitle && <p class="mt-5 text-base leading-relaxed text-fg-muted sm:text-lg">{subtitle}</p>}
</div>
