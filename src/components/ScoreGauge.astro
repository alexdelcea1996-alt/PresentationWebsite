---
/**
 * A Lighthouse-style dial for a measured score.
 *
 * The arc sweeps in when the dial scrolls into view, with **no JavaScript**:
 * the reveal observer the site already runs adds `.is-visible`, and CSS
 * transitions `stroke-dashoffset`. Without scripting the arc is drawn full
 * immediately — the number is the point, the sweep is the garnish.
 *
 * The target offset cannot travel in a `style` attribute: this site's CSP sets
 * `style-src` without `unsafe-inline`, so the browser discards inline style
 * attributes wholesale — silently, as far as the page is concerned. It comes in
 * through a hashed <style> block emitted by the page instead (see
 * `gaugeCss` in CaseStudyPage.astro), keyed on `data-score`.
 *
 * `pathLength="100"` rescales the circle so one unit of dash is one percent,
 * which is what makes those generated rules a single readable number.
 */
interface Props {
  score: number;
  value: string;
  label: string;
  delay?: number;
}

const { score, value, label, delay = 0 } = Astro.props;

// Lighthouse's own thresholds. Sent as an attribute rather than inferred from
// the number in CSS, which cannot compare values without brittle string tricks.
const band = score >= 90 ? 'good' : score >= 50 ? 'ok' : 'poor';
---

<div
  class="score-gauge flex flex-col items-center text-center"
  data-reveal
  data-reveal-delay={delay}
  data-band={band}
  data-score={score}
>
  <div class="relative">
    <svg viewBox="0 0 120 120" class="size-28 -rotate-90" aria-hidden="true">
      <circle cx="60" cy="60" r="52" class="gauge-track" />
      <circle cx="60" cy="60" r="52" pathLength="100" class="gauge-arc" />
    </svg>
    <span
      class="absolute inset-0 grid place-items-center font-display text-2xl font-semibold tabular-nums text-fg"
    >
      {score}
    </span>
  </div>

  <p class="mt-3 text-sm font-medium text-fg">{label}</p>
  {/* The dial shows the score; this line carries the exact wording, e.g. "98/100". */}
  <p class="mt-0.5 text-xs text-fg-subtle">{value}</p>
</div>
