---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getContent, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = '' } = Astro.props;
const t = getContent(locale);

const options = locales.map((code) => ({
  code,
  href: getRelativeLocaleUrl(code),
  label: code.toUpperCase(),
  full: code === 'ro' ? t.langSwitch.ro : t.langSwitch.en,
  active: code === locale,
}));
---

<div
  class={`flex items-center gap-0.5 rounded-lg border border-border bg-surface-raised/70 p-0.5 ${className}`}
  role="group"
  aria-label={t.langSwitch.label}
  data-lang-switcher
>
  {
    options.map((option) => (
      <a
        href={option.href}
        hreflang={option.code}
        lang={option.code}
        title={option.full}
        aria-current={option.active ? 'true' : undefined}
        class:list={[
          'rounded-md px-2.5 py-1 text-xs font-semibold transition-colors',
          option.active
            ? 'bg-accent/20 text-fg'
            : 'text-fg-subtle hover:bg-border hover:text-fg',
        ]}
      >
        <span class="sr-only">{option.full}</span>
        <span aria-hidden="true">{option.label}</span>
      </a>
    ))
  }
</div>

<script>
  // On sub-pages the server-rendered hrefs point at the other language's home
  // page. The <head> already carries the correct per-page alternates for SEO,
  // so reuse them here rather than threading URLs through every component.
  const useHeadAlternates = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-switcher] a').forEach((link) => {
      const code = link.getAttribute('hreflang');
      const alternate = document.querySelector<HTMLLinkElement>(
        `link[rel="alternate"][hreflang^="${code}"]`,
      );
      // Take only the path: the alternates carry the production origin, which
      // would bounce local previews and PR deployments over to the live site.
      if (alternate) link.pathname = new URL(alternate.href).pathname;
    });
  };

  // Carry the reader's position across the language switch: if they are looking
  // at #pricing in Romanian, the English link should land on #pricing too.
  const syncHash = () => {
    const hash = window.location.hash;
    if (!hash) return;
    document
      .querySelectorAll<HTMLAnchorElement>('[data-lang-switcher] a:not([aria-current])')
      .forEach((link) => {
        link.hash = hash;
      });
  };

  useHeadAlternates();
  syncHash();
  window.addEventListener('hashchange', syncHash);
</script>
