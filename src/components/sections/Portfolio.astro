---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { getContent, sectionIds, type Locale } from '../../i18n';
import { caseStudyPath, getCaseStudies } from '../../data/case-studies';
import DemoFrame from '../DemoFrame.astro';
import { contactPath, exampleSitePath } from '../../data/demo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).portfolio;

// Real case studies come from `src/content/case-studies/`. Until one exists for
// this locale the section shows honest empty slots rather than invented work.
const caseStudies = await getCaseStudies(locale);
const placeholderSlots = 2;
---

<section id={sectionIds.portfolio} class="py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <div class="mt-16 grid gap-6 lg:grid-cols-2">
      {
        caseStudies.length > 0
          ? caseStudies.map((entry, index) => (
              <article class="card card-hover flex flex-col" data-reveal data-reveal-delay={index * 80}>
                {entry.data.coverDesktop && (
                  <div class="-mx-6 -mt-6 mb-6 overflow-hidden rounded-t-2xl border-b border-border">
                    <Image
                      src={entry.data.coverDesktop}
                      alt={entry.data.coverAlt ?? entry.data.title}
                      widths={[420, 840]}
                      sizes="(min-width: 768px) 420px, 100vw"
                      format="avif"
                      loading="lazy"
                      class="block aspect-[16/10] w-full object-cover object-top"
                    />
                  </div>
                )}

                <p class="eyebrow text-xs">{entry.data.category}</p>

                <h3 class="mt-3 text-xl font-semibold">
                  <a
                    href={caseStudyPath(locale, entry.data.urlSlug)}
                    class="after:absolute after:inset-0 hover:text-accent-alt"
                  >
                    {entry.data.title}
                  </a>
                </h3>

                <p class="mt-3 text-sm leading-relaxed text-fg-muted">{entry.data.summary}</p>

                {entry.data.metrics.length > 0 && (
                  <dl class="mt-6 grid grid-cols-2 gap-3">
                    {entry.data.metrics.slice(0, 4).map((metric) => (
                      <div class="rounded-lg border border-border bg-surface/50 px-3 py-2.5">
                        <dd class="font-display text-base font-semibold text-gradient">
                          {metric.value}
                        </dd>
                        <dt class="mt-0.5 text-xs text-fg-subtle">{metric.label}</dt>
                      </div>
                    ))}
                  </dl>
                )}

                <ul class="mt-6 flex flex-wrap gap-2 border-t border-border pt-6">
                  {entry.data.tech.map((tech) => (
                    <li class="rounded-md border border-border bg-surface-hover px-2.5 py-1 text-xs text-fg-muted">
                      {tech}
                    </li>
                  ))}
                </ul>

                <p class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-alt">
                  {t.readMore}
                  <Icon name="arrow-right" class="size-4" />
                </p>
              </article>
            ))
          : Array.from({ length: placeholderSlots }).map((_, index) => (
              <div
                class="card-placeholder flex min-h-56 flex-col items-center justify-center text-center"
                data-reveal
                data-reveal-delay={index * 80}
              >
                <span class="grid size-11 place-items-center rounded-xl border border-border-strong text-fg-subtle">
                  <Icon name="browser" class="size-5" />
                </span>
                <p class="mt-4 font-display text-base font-semibold text-fg-muted">
                  {t.emptyTitle}
                </p>
                <p class="mt-2 max-w-xs text-sm leading-relaxed">{t.emptyBody}</p>
              </div>
            ))
      }
    </div>

    {/*
      A working site, in the section where somebody is looking for proof — and
      labelled as invented right above it, because fiction standing unlabelled
      among proof is the one thing this site will not do.

      Below the fold and lazily framed, so it costs the landing page nothing
      until somebody scrolls this far. The frame's controller is per-instance,
      which is what makes a second frame on this page safe at all.
    */}
    <div class="mx-auto mt-20 max-w-4xl" data-reveal data-portfolio-example>
      <h3 class="font-display text-xl font-semibold">{t.exampleTitle}</h3>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-fg-muted">{t.exampleBody}</p>

      <div class="mt-8">
        <DemoFrame
          locale={locale}
          src={exampleSitePath(locale)}
          displayUrl="termoflux.example"
          ctaHref={contactPath(locale, 'presentation', 'portfolio-example')}
        />
      </div>
    </div>
  </div>
</section>
