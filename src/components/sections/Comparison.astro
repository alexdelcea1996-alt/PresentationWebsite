---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { getContent, sectionIds, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).comparison;
---

<section id={sectionIds.comparison} class="py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    {/* Table on wide screens; the same rows become stacked cards on phones. */}
    <div class="mt-16 hidden overflow-x-auto md:block" data-reveal>
      <table class="w-full border-collapse text-left text-sm">
        <caption class="sr-only">{t.title}</caption>
        <thead>
          <tr>
            <th scope="col" class="w-1/4 pb-4 pr-4 font-display text-sm font-semibold text-fg-subtle">
              <span class="sr-only">{t.criterionLabel}</span>
            </th>
            <th
              scope="col"
              class="w-[37.5%] rounded-t-xl bg-ink-850/60 px-5 pb-4 pt-5 font-display text-base font-semibold text-fg-muted"
            >
              {t.columnDiy}
            </th>
            <th
              scope="col"
              class="w-[37.5%] rounded-t-xl border-x border-t border-accent/30 bg-accent/10 px-5 pb-4 pt-5 font-display text-base font-semibold text-fg"
            >
              {t.columnCustom}
            </th>
          </tr>
        </thead>
        <tbody>
          {
            t.rows.map((row) => (
              <tr class="align-top">
                <th
                  scope="row"
                  class="border-t border-ink-700 py-4 pr-4 font-display text-sm font-semibold text-fg"
                >
                  {row.criterion}
                </th>
                <td class="border-t border-ink-700 bg-ink-850/60 px-5 py-4 text-fg-muted">
                  <span>{row.diy}</span>
                  {row.diyWins && (
                    <span class="mt-2 flex items-center gap-1.5 text-xs font-medium text-accent-alt">
                      <Icon name="check" class="size-3.5" />
                      {t.diyWinsLabel}
                    </span>
                  )}
                </td>
                <td class="border-x border-t border-accent/30 bg-accent/10 px-5 py-4 text-fg-muted">
                  {row.custom}
                </td>
              </tr>
            ))
          }
          <tr aria-hidden="true">
            <td></td>
            <td class="rounded-b-xl bg-ink-850/60"></td>
            <td class="rounded-b-xl border-x border-b border-accent/30 bg-accent/10"></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-14 grid gap-4 md:hidden">
      {
        t.rows.map((row, index) => (
          <article class="card" data-reveal data-reveal-delay={index * 40}>
            <h3 class="font-display text-base font-semibold">{row.criterion}</h3>

            <div class="mt-4 space-y-3 text-sm">
              <div class="rounded-lg bg-ink-900/60 p-3">
                <p class="text-xs font-medium uppercase tracking-wider text-fg-subtle">
                  {t.columnDiy}
                </p>
                <p class="mt-1.5 text-fg-muted">{row.diy}</p>
                {row.diyWins && (
                  <p class="mt-2 flex items-center gap-1.5 text-xs font-medium text-accent-alt">
                    <Icon name="check" class="size-3.5" />
                    {t.diyWinsLabel}
                  </p>
                )}
              </div>

              <div class="rounded-lg border border-accent/30 bg-accent/10 p-3">
                <p class="text-xs font-medium uppercase tracking-wider text-accent-alt">
                  {t.columnCustom}
                </p>
                <p class="mt-1.5 text-fg-muted">{row.custom}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p
      class="mx-auto mt-12 max-w-2xl rounded-2xl border border-ink-700 bg-ink-850/50 p-6 text-center text-sm leading-relaxed text-fg-muted"
      data-reveal
    >
      {t.honestNote}
    </p>
  </div>
</section>
