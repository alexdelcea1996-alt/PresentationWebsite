---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { getContent, sectionIds, type Locale } from '../../i18n';
import { contactPath } from '../../data/demo';

interface Props {
  locale: Locale;
  /** True when this section opens a page of its own and owns its `h1`. */
  lead?: boolean;
}

const { locale, lead = false } = Astro.props;
/**
 * Card headings sit one level under whatever this section's own heading is.
 *
 * The section is `h2` when it is one of several on a page and `h1` when it is
 * what a page is about, so a hard-coded `h3` under it is a skipped level in
 * exactly one of those two cases — which is what axe caught the first time
 * these sections were reused as pages.
 */
const Sub = lead ? 'h2' : 'h3';
const t = getContent(locale).pricing;
---

<section id={sectionIds.pricing} class="py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading
      eyebrow={t.eyebrow}
      title={t.title}
      subtitle={t.subtitle}
      level={lead ? 1 : 2}
    />

    <div class="mt-16 grid items-start gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        t.plans.map((plan, index) => (
          <article
            class:list={[
              'card flex h-full flex-col',
              plan.featured
                ? // The lift only reads as emphasis when every card is on one row; in the
                  // two-column layout it just looks like a card that failed to line up.
                  'beam border-accent/45 bg-surface-hover shadow-[0_24px_60px_-30px] shadow-accent/60 xl:-mt-4 xl:pb-10'
                : 'card-hover',
            ]}
            data-reveal
            data-reveal-delay={index * 80}
            data-plan-beam={plan.featured ? '' : undefined}
          >
            {plan.featured && (
              <p class="mb-5 inline-flex w-fit items-center gap-1.5 rounded-full bg-linear-110 from-accent to-accent-alt px-3 py-1 text-xs font-semibold text-on-accent">
                {t.popular}
              </p>
            )}

            {/* Named parts, so a check can find the price without depending on
                which heading level this section happens to be wearing. */}
            <Sub class="font-display text-lg font-semibold" data-plan-name>{plan.name}</Sub>

            <p class="mt-4 font-display text-3xl font-semibold text-fg" data-plan-price>
              {plan.price}
            </p>
            <p class="mt-1.5 text-xs text-fg-subtle" data-plan-note>{plan.priceNote}</p>

            <p class="mt-5 text-sm leading-relaxed text-fg-muted">{plan.description}</p>

            <ul class="mt-6 grow space-y-2.5 border-t border-border pt-6">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm text-fg-muted">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-alt" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href={contactPath(locale, undefined, 'pricing')}
              class:list={['btn mt-8 w-full', plan.featured ? 'btn-primary' : 'btn-ghost']}
            >
              {plan.cta}
            </a>
          </article>
        ))
      }
    </div>

    <p class="mx-auto mt-10 max-w-2xl text-center text-xs leading-relaxed text-fg-subtle" data-reveal>
      {t.note}
    </p>
  </div>
</section>

<script>
  // --- Stop the beam when nobody is looking at it ---
  //
  // The ring animates a custom property, which by specification cannot be handed
  // to the compositor: every frame is a repaint on the main thread. That is an
  // accepted cost while the card is on screen and a pointless one when it is
  // not — and the pricing section spends most of a visit scrolled past.
  //
  // Pausing rather than removing: `animation-play-state` freezes the angle where
  // it stood, so scrolling back finds the ring where it was left rather than
  // snapped to zero.
  const beams = document.querySelectorAll<HTMLElement>('[data-plan-beam]');

  if (beams.length) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        (entry.target as HTMLElement).toggleAttribute('data-beam-idle', !entry.isIntersecting);
      }
    });
    beams.forEach((card) => observer.observe(card));
  }
</script>
