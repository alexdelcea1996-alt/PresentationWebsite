---
/**
 * Commitments the site already makes, gathered where a visitor will actually
 * read them — they were scattered across service pages before, several clicks
 * deep. Nothing here is a new promise.
 *
 * The second column is the point. The site says elsewhere that nobody honest
 * can guarantee a Google ranking; a guarantees section that quietly skipped
 * that would contradict the rest of the site and read like every other one.
 */
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { getContent, sectionIds, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).guarantees;

const columns = [
  { id: 'yes', title: t.yesTitle, items: t.yes, icon: 'check' as const },
  { id: 'no', title: t.noTitle, items: t.no, icon: 'minus' as const },
];
---

<section id={sectionIds.guarantees} class="relative overflow-hidden py-20 sm:py-28">
  <div class="glow right-[-10rem] top-1/4 size-[24rem] bg-accent-alt/10" aria-hidden="true"></div>

  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <div class="mx-auto mt-16 grid max-w-5xl gap-6 lg:grid-cols-[1.25fr_1fr] lg:items-start">
      {
        columns.map((column) => (
          <div
            class:list={[
              'card',
              column.id === 'no' && 'border-dashed bg-transparent',
            ]}
            data-reveal
            data-reveal-delay={column.id === 'no' ? 100 : 0}
            data-guarantee-column={column.id}
          >
            <h3
              class:list={[
                'flex items-center gap-2 font-display text-sm font-semibold uppercase tracking-[0.14em]',
                column.id === 'yes' ? 'text-accent-alt' : 'text-fg-subtle',
              ]}
            >
              {column.title}
            </h3>

            <ul class="mt-6 space-y-6">
              {column.items.map((item) => (
                <li class="flex items-start gap-3">
                  <span
                    class:list={[
                      'mt-0.5 grid size-6 shrink-0 place-items-center rounded-full',
                      column.id === 'yes'
                        ? 'bg-accent/10 text-accent-alt'
                        : 'border border-border-strong text-fg-subtle',
                    ]}
                  >
                    <Icon name={column.icon} class="size-3.5" />
                  </span>
                  <div class="min-w-0">
                    <p class="font-display text-sm font-semibold text-fg">{item.title}</p>
                    <p class="mt-1.5 text-sm leading-relaxed text-fg-muted">{item.body}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
