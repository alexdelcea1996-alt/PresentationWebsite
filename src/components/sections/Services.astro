---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { getContent, sectionIds, type Locale } from '../../i18n';
import { getServicePages, servicePath } from '../../data/services';
import { demoForService } from '../../data/demo';

interface Props {
  locale: Locale;
  /**
   * Where to read the rest, when this section is standing in for a page.
   *
   * The landing page shows the cards and stops; the page they summarise is one
   * link away. Absent when the section IS the page, because a page that links
   * to itself at the bottom is a page that has run out of things to say.
   */
  more?: { href: string; label: string };
  /** True when this section opens a page of its own and owns its `h1`. */
  lead?: boolean;
  /**
   * Summary rather than the whole thing.
   *
   * The landing page shows these cards and the services page shows them too,
   * which is the shape of an SEO problem: two indexable pages competing on the
   * same words. Compact drops the feature lists and the demo buttons — what is
   * left is a name, a sentence and a way through, which is what a summary is.
   */
  compact?: boolean;
}

const { locale, lead = false, compact = false, more } = Astro.props;
/**
 * Card headings sit one level under whatever this section's own heading is.
 *
 * The section is `h2` when it is one of several on a page and `h1` when it is
 * what a page is about, so a hard-coded `h3` under it is a skipped level in
 * exactly one of those two cases — which is what axe caught the first time
 * these sections were reused as pages.
 */
const Sub = lead ? 'h2' : 'h3';
const t = getContent(locale).services;

// A card links through only when a landing page exists for that service yet.
const pages = await getServicePages(locale);
const pathByKey = new Map(pages.map((page) => [page.data.key, servicePath(locale, page.data.urlSlug)]));

// An odd number of cards would leave the last one stranded in a half-empty row.
// It spans instead — which happens to suit the one that is there, since
// maintenance is the option for people who already have a site.
const spanLast = t.items.length % 2 === 1;
---

<section id={sectionIds.services} class="py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading
      eyebrow={t.eyebrow}
      title={t.title}
      subtitle={t.subtitle}
      level={lead ? 1 : 2}
    />

    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      {
        t.items.map((service, index) => {
          const href = service.key ? pathByKey.get(service.key) : undefined;
          // Each demo belongs to the one offer it actually shows: the bookings app
          // under "web application", the store under "online store".
          const demoHref = demoForService(locale, service.key);

          return (
          <article
            class:list={[
              'card card-hover flex flex-col',
              !compact && 'grow',
              spanLast && index === t.items.length - 1 && 'sm:col-span-2',
            ]}
            data-reveal
            data-reveal-delay={index * 80}
          >
            <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-accent/25 bg-accent/10 text-accent-alt">
              <Icon name={service.icon} class="size-5" />
            </span>

            <Sub class="mt-5 text-xl font-semibold">
              {
                href ? (
                  <a href={href} class="after:absolute after:inset-0 hover:text-accent-alt">
                    {service.title}
                  </a>
                ) : (
                  service.title
                )
              }
            </Sub>
            <p class="mt-3 text-sm leading-relaxed text-fg-muted">{service.description}</p>

            {!compact && (
              <ul class="mt-6 grow space-y-2.5 border-t border-border pt-6">
                {service.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm text-fg-muted">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-alt" />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            )}

            {(href || demoHref) && (
              <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
                {href && (
                  <p class="inline-flex items-center gap-2 text-sm font-semibold text-accent-alt">
                    {t.readMore}
                    <Icon name="arrow-right" class="size-4" />
                  </p>
                )}
                {/* The title above is a stretched link covering the whole card, so
                    this one needs to sit above that overlay or the click is eaten
                    and the visitor lands on the service page instead. */}
                {demoHref && (
                  <a
                    href={demoHref}
                    class="btn btn-ghost relative z-10 px-3.5 py-2 text-xs"
                    data-demo-cta
                  >
                    {t.demoCta}
                    <Icon name="arrow-right" class="size-3.5" />
                  </a>
                )}
              </div>
            )}
          </article>
          );
        })
      }
    </div>

    {
      more && (
        <p class="mt-12 text-center" data-reveal data-section-more>
          <a
            href={more.href}
            class="text-sm font-semibold text-accent-alt underline underline-offset-4 hover:no-underline"
          >
            {more.label}
            <Icon name="arrow-right" class="inline size-4 align-[-3px]" />
          </a>
        </p>
      )
    }
  </div>
</section>
