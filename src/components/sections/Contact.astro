---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { getContent, sectionIds, type Locale } from '../../i18n';
import { site, telHref, whatsappHref } from '../../data/site';
import { getLegalPage, legalPath } from '../../data/legal';
import { thankYouPath } from '../../data/demo';
import BookingCard from '../BookingCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).contact;
const legal = getContent(locale).legal;

// The policy is a content entry, so the address comes from its own front matter
// rather than being written twice.
const privacy = await getLegalPage(locale, 'privacy');
const privacyHref = legalPath(locale, privacy.data.urlSlug);

const tel = telHref();
const whatsapp = whatsappHref(t.whatsappMessage);

const contactRowClass =
  'flex items-start gap-3 rounded-xl border border-border bg-surface/60 p-4 transition-colors hover:border-accent/40';

const fieldClass =
  'w-full rounded-xl border border-border bg-surface/70 px-4 py-3 text-sm text-fg placeholder:text-fg-subtle transition-colors focus:border-accent focus:outline-none';
const labelClass = 'block text-sm font-medium text-fg';
---

<section id={sectionIds.contact} class="relative overflow-hidden py-20 sm:py-28">
  <div
    class="glow left-1/2 bottom-[-8rem] size-[34rem] -translate-x-1/2 bg-accent/18"
    aria-hidden="true"
  >
  </div>

  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <div class="mx-auto mt-16 grid max-w-5xl gap-6 lg:grid-cols-[1.6fr_1fr] lg:items-start">
      <form
        class="card space-y-5"
        data-contact-form
        data-access-key={site.web3formsKey}
        data-mailto={site.email}
        data-thanks={thankYouPath(locale)}
        data-step-progress-text={t.form.steps.progress}
        data-step-titles={JSON.stringify(t.form.steps.titles)}
        novalidate
        data-reveal
      >
        {/*
          The progress line for the stepped version. Empty and hidden in the
          markup: without JavaScript there are no steps to count, and a form
          that announces "step 1 of 3" while showing all three would be lying
          about itself.
        */}
        <div class="hidden" data-step-progress>
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-accent-alt" role="status">
            <span data-step-counter></span>
          </p>
          <p class="mt-1.5 font-display text-lg font-semibold text-fg" data-step-title></p>
          <div class="mt-3 h-1 overflow-hidden rounded-full bg-border">
            <div class="h-full rounded-full bg-linear-110 from-accent to-accent-alt" data-step-bar>
            </div>
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2" data-step="2">
          <div>
            <label class={labelClass} for="field-name">
              {t.form.name}
              <span class="text-accent-alt" aria-hidden="true">*</span>
              <span class="sr-only">({t.form.required})</span>
            </label>
            <input
              class={`mt-2 ${fieldClass}`}
              id="field-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              placeholder={t.form.namePlaceholder}
            />
          </div>

          <div>
            <label class={labelClass} for="field-email">
              {t.form.email}
              <span class="text-accent-alt" aria-hidden="true">*</span>
              <span class="sr-only">({t.form.required})</span>
            </label>
            <input
              class={`mt-2 ${fieldClass}`}
              id="field-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder={t.form.emailPlaceholder}
            />
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2" data-step="1">
          <div>
            <label class={labelClass} for="field-type">{t.form.projectType}</label>
            {/* value stays human-readable for the email; data-id is the stable
                handle the configurator and audit band select by. */}
            <select class={`mt-2 ${fieldClass}`} id="field-type" name="project_type">
              {
                t.form.projectTypeOptions.map((option) => (
                  <option value={option.label} data-id={option.id}>
                    {option.label}
                  </option>
                ))
              }
            </select>
          </div>

          <div>
            <label class={labelClass} for="field-budget">{t.form.budget}</label>
            <select class={`mt-2 ${fieldClass}`} id="field-budget" name="budget">
              {
                t.form.budgetOptions.map((option) => (
                  <option value={option.label} data-id={option.id}>
                    {option.label}
                  </option>
                ))
              }
            </select>
          </div>
        </div>

        <div data-step="2">
          <label class={labelClass} for="field-website">{t.form.website}</label>
          <input
            class={`mt-2 ${fieldClass}`}
            id="field-website"
            name="website"
            type="url"
            inputmode="url"
            autocomplete="url"
            placeholder={t.form.websitePlaceholder}
          />
          <p class="mt-2 text-xs text-fg-subtle">{t.form.websiteHint}</p>
        </div>

        <div data-step="3">
          <label class={labelClass} for="field-message">
            {t.form.message}
            <span class="text-accent-alt" aria-hidden="true">*</span>
            <span class="sr-only">({t.form.required})</span>
          </label>
          <textarea
            class={`mt-2 resize-y ${fieldClass}`}
            id="field-message"
            name="message"
            rows="5"
            required
            placeholder={t.form.messagePlaceholder}></textarea>
        </div>

        {/*
          Filled by the script when a `?from=` link preselected the type. The
          form must never change silently under the visitor: they can see what
          was chosen for them, and change it.
        */}
        <p
          class="hidden rounded-xl border border-accent/25 bg-accent/5 px-4 py-3 text-xs leading-relaxed text-fg-muted"
          data-step="1"
          data-prefill-note
          data-template={t.form.prefillNote}
        >
        </p>

        {/* Honeypot: hidden from people, tempting to bots. */}
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        {/* Only rendered as navigation when the stepped version is running. */}
        <div class="hidden gap-3" data-step-nav>
          <button type="button" class="btn btn-ghost flex-1 text-sm" data-step-back>
            {t.form.steps.back}
          </button>
          <button type="button" class="btn btn-primary flex-1 text-sm" data-step-next>
            {t.form.steps.next}
          </button>
        </div>

        <button type="submit" class="btn btn-primary w-full" data-submit data-step="3">
          <span data-submit-idle>{t.form.submit}</span>
          <span class="hidden" data-submit-busy>{t.form.sending}</span>
        </button>

        {/* The published reply promise, restated at the exact moment of decision. */}
        <p
          class="flex items-start justify-center gap-2 text-xs text-fg-subtle"
          data-step="3"
          data-submit-note
        >
          <Icon name="check" class="mt-0.5 size-3.5 shrink-0 text-accent-alt" />
          {t.form.submitNote}
        </p>

        <p
          class="hidden rounded-xl border border-accent-alt/40 bg-accent-alt/10 px-4 py-3 text-sm text-fg"
          role="status"
          data-form-success
        >
          {t.form.success}
        </p>

        {/*
          The honest ending of the mailto fallback. This branch opens the
          visitor's mail client and has no way of knowing whether one exists, so
          it must never claim the message arrived — the old version did, and on
          a machine with no mail client the lead died believing it had written.
        */}
        <div
          class="hidden rounded-xl border border-border bg-surface-raised/70 px-4 py-4"
          role="status"
          data-form-fallback
        >
          <p class="font-display text-sm font-semibold text-fg">{t.form.fallbackTitle}</p>
          <p class="mt-2 text-sm leading-relaxed text-fg-muted">{t.form.fallbackBody}</p>
          <div class="mt-4 flex flex-col gap-2 sm:flex-row">
            {
              site.whatsapp && (
                <a
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary flex-1 text-sm"
                  data-fallback-wa
                  data-wa-digits={site.whatsapp.replace(/\D/g, '')}
                >
                  <Icon name="whatsapp" class="size-4" />
                  {t.form.fallbackWhatsapp}
                </a>
              )
            }
            <button type="button" class="btn btn-ghost flex-1 text-sm" data-fallback-copy>
              <span data-copy-idle>{t.form.fallbackCopy}</span>
              <span class="hidden" data-copy-done>{t.form.fallbackCopied}</span>
            </button>
          </div>
        </div>
        <p
          class="hidden rounded-xl border border-red-400/40 bg-red-400/10 px-4 py-3 text-sm text-fg"
          role="alert"
          data-form-error
        >
          {t.form.error}
        </p>

        <p class="text-xs leading-relaxed text-fg-subtle">
          {t.form.privacy}{' '}
          <a
            href={privacyHref}
            class="text-accent-alt underline underline-offset-4 hover:no-underline"
            data-privacy-link
          >
            {legal.privacyLink}
          </a>
        </p>
      </form>

      <aside class="card" data-reveal data-reveal-delay="100">
        <h3 class="font-display text-lg font-semibold">{t.directTitle}</h3>
        <p class="mt-3 text-sm leading-relaxed text-fg-muted">{t.directBody}</p>

        <a href={`mailto:${site.email}`} class={`mt-6 ${contactRowClass}`}>
          <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-accent/10 text-accent-alt">
            <Icon name="mail" class="size-4" />
          </span>
          <span class="min-w-0">
            <span class="block text-xs text-fg-subtle">{t.emailLabel}</span>
            <span class="block truncate text-sm font-medium text-fg">{site.email}</span>
          </span>
        </a>

        {
          tel && (
            <a href={tel} class={`mt-3 ${contactRowClass}`}>
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-accent/10 text-accent-alt">
                <Icon name="phone" class="size-4" />
              </span>
              <span class="min-w-0">
                <span class="block text-xs text-fg-subtle">{t.phoneLabel}</span>
                <span class="block truncate text-sm font-medium text-fg">{site.phone}</span>
              </span>
            </a>
          )
        }

        {
          whatsapp && (
            <a
              href={whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class={`mt-3 ${contactRowClass}`}
            >
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-accent/10 text-accent-alt">
                <Icon name="whatsapp" class="size-4" />
              </span>
              <span class="min-w-0">
                <span class="block text-xs text-fg-subtle">{t.whatsappLabel}</span>
                {/* The number is already on the phone row above; this one
                    carries the action instead of repeating it. */}
                <span class="block truncate text-sm font-medium text-fg">{t.whatsappAction}</span>
              </span>
            </a>
          )
        }

        <p class="mt-5 flex items-start gap-2 text-xs leading-relaxed text-fg-subtle">
          <Icon name="check" class="mt-0.5 size-3.5 shrink-0 text-accent-alt" />
          {t.responseTime}
        </p>

        {site.calLink && <BookingCard locale={locale} />}
      </aside>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const idle = form.querySelector<HTMLElement>('[data-submit-idle]')!;
    const busy = form.querySelector<HTMLElement>('[data-submit-busy]')!;
    const successBox = form.querySelector<HTMLElement>('[data-form-success]')!;
    const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!;
    const fallbackBox = form.querySelector<HTMLElement>('[data-form-fallback]')!;

    /**
     * Context handed over by whatever page sent the visitor here.
     *
     * `from` preselects the project type through the same stable `data-id`
     * handles the configurator uses; `via` is stamped into the message so the
     * lead email says which page did the convincing. Both are announced in a
     * visible note — a form that rearranges itself silently is a form the
     * visitor stops trusting.
     */
    {
      const params = new URLSearchParams(window.location.search);
      const from = params.get('from');
      const via = params.get('via');
      const typeSelect = form.querySelector<HTMLSelectElement>('#field-type');
      const note = form.querySelector<HTMLElement>('[data-prefill-note]');

      if (from && typeSelect) {
        const match = [...typeSelect.options].find((option) => option.dataset.id === from);
        if (match) {
          typeSelect.value = match.value;
          if (note?.dataset.template) {
            note.textContent = note.dataset.template.replace('{label}', match.textContent ?? '');
            note.classList.remove('hidden');
          }
        }
      }

      if (via) {
        const stamp = document.createElement('input');
        stamp.type = 'hidden';
        stamp.name = 'origin';
        stamp.value = via;
        form.append(stamp);
      }
    }

    /**
     * The stepped version, built on top of the form that is already there.
     *
     * Nothing is duplicated: the same inputs, the same names, the same ids the
     * configurator and the audit band preselect by, and the same submit
     * handler below. All this does is decide which group is on screen. With no
     * JavaScript the classic form stands untouched — which is also why the
     * progress line ships empty and hidden rather than announcing "step 1 of
     * 3" over a form that is showing all three.
     *
     * Visibility is a `data-step-hidden` attribute rather than the `hidden`
     * class, so it composes with elements that manage their own `hidden` —
     * the prefill note is in step 1 and must stay hidden unless a prefill
     * actually happened.
     */
    const stepGroups = [...form.querySelectorAll<HTMLElement>('[data-step]')];
    const progress = form.querySelector<HTMLElement>('[data-step-progress]');
    const nav = form.querySelector<HTMLElement>('[data-step-nav]');

    if (stepGroups.length > 0 && progress && nav) {
      const TOTAL = 3;
      const titles = JSON.parse(form.dataset.stepTitles ?? '[]') as string[];
      const counterText = form.dataset.stepProgressText ?? '';
      const counter = form.querySelector<HTMLElement>('[data-step-counter]')!;
      const title = form.querySelector<HTMLElement>('[data-step-title]')!;
      const bar = form.querySelector<HTMLElement>('[data-step-bar]')!;
      const back = form.querySelector<HTMLButtonElement>('[data-step-back]')!;
      const next = form.querySelector<HTMLButtonElement>('[data-step-next]')!;

      let current = 1;

      const show = (step: number, focus = true) => {
        current = Math.min(Math.max(step, 1), TOTAL);

        for (const group of stepGroups) {
          group.toggleAttribute('data-step-hidden', Number(group.dataset.step) !== current);
        }

        counter.textContent = counterText
          .replace('{current}', String(current))
          .replace('{total}', String(TOTAL));
        title.textContent = titles[current - 1] ?? '';
        // CSSOM, not a style attribute: the CSP drops those silently.
        bar.style.width = `${(current / TOTAL) * 100}%`;

        back.classList.toggle('hidden', current === 1);
        next.classList.toggle('hidden', current === TOTAL);

        if (!focus) return;
        const first = form.querySelector<HTMLElement>(
          `[data-step="${current}"] input, [data-step="${current}"] select, [data-step="${current}"] textarea`,
        );
        first?.focus();
      };

      next.addEventListener('click', () => {
        // Validate only what is on screen. Reporting on a hidden field would
        // ask the browser to focus something nobody can see.
        const fields = [
          ...form.querySelectorAll<HTMLInputElement>(`[data-step="${current}"] :is(input, textarea)`),
        ];
        const invalid = fields.find((field) => !field.checkValidity());
        if (invalid) {
          invalid.reportValidity();
          return;
        }
        show(current + 1);
      });

      back.addEventListener('click', () => show(current - 1));

      // A submit from anywhere must be able to reveal the step that is holding
      // an invalid field, otherwise `reportValidity` below fails silently on
      // something off screen.
      form.addEventListener('invalid', (event) => {
        const field = event.target as HTMLElement;
        const group = field.closest<HTMLElement>('[data-step]');
        if (group && Number(group.dataset.step) !== current) show(Number(group.dataset.step), false);
      }, true);

      /**
       * Anything that fills the form from elsewhere — the configurator handing
       * over an estimate, the audit band handing over an address — announces
       * itself here, and the visitor is taken to the step that field lives on.
       * Without this they would land on step 1 and have to click through to
       * find the message that was just written for them.
       */
      form.addEventListener('contact:filled', (event) => {
        const step = Number((event as CustomEvent<{ step?: number }>).detail?.step ?? TOTAL);
        show(step, false);
      });

      progress.classList.remove('hidden');
      nav.classList.remove('hidden');
      nav.classList.add('flex');
      form.dataset.stepped = '';
      show(1, false);
    }

    const setBusy = (state: boolean) => {
      submit.disabled = state;
      idle.classList.toggle('hidden', state);
      busy.classList.toggle('hidden', !state);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      successBox.classList.add('hidden');
      errorBox.classList.add('hidden');
      fallbackBox.classList.add('hidden');

      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const accessKey = form.dataset.accessKey;

      // No form service configured yet: hand the message over to the visitor's
      // mail client instead of silently dropping it.
      //
      // Crucially, do NOT claim success. This branch cannot know whether a mail
      // client even exists on the machine — on many desktops nothing opens at
      // all. So it says what it did and offers two exits that work regardless:
      // WhatsApp with the same message, or the message on the clipboard.
      if (!accessKey) {
        const website = String(data.get('website') ?? '').trim();
        const origin = String(data.get('origin') ?? '').trim();
        const lines = [
          `${data.get('name')} <${data.get('email')}>`,
          `${data.get('project_type')} — ${data.get('budget')}`,
          ...(website ? [website] : []),
          // Same stamp as the Web3Forms path carries, so both routes tell me
          // which page did the convincing.
          ...(origin ? [`(${origin})`] : []),
          '',
          String(data.get('message') ?? ''),
        ];
        const to = form.dataset.mailto ?? '';
        const text = lines.join('\n');
        const subject = encodeURIComponent(`Website enquiry — ${data.get('name')}`);

        // Arm both rescue exits with the composed message before navigating.
        const wa = fallbackBox.querySelector<HTMLAnchorElement>('[data-fallback-wa]');
        if (wa) {
          wa.href = `https://wa.me/${wa.dataset.waDigits}?text=${encodeURIComponent(text)}`;
        }
        const copy = fallbackBox.querySelector<HTMLButtonElement>('[data-fallback-copy]');
        if (copy && !copy.dataset.armed) {
          copy.dataset.armed = '1';
          copy.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(`${to}\n\n${text}`);
              copy.querySelector('[data-copy-idle]')?.classList.add('hidden');
              copy.querySelector('[data-copy-done]')?.classList.remove('hidden');
            } catch {
              // Clipboard blocked: leave the label as it is; the mailto and
              // WhatsApp routes still stand.
            }
          });
        }

        fallbackBox.classList.remove('hidden');
        window.location.href = `mailto:${to}?subject=${subject}&body=${encodeURIComponent(text)}`;
        return;
      }

      setBusy(true);
      data.append('access_key', accessKey);
      data.append('subject', `Website enquiry — ${data.get('name')}`);
      data.append('from_name', String(data.get('name') ?? ''));

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });

        if (!response.ok) throw new Error(`Request failed with ${response.status}`);

        successBox.classList.remove('hidden');
        form.reset();

        // Only here — after the service confirmed delivery. The mailto branch
        // has no such confirmation to offer and keeps its rescue panel, because
        // a thank-you page a failed send can reach is the false success this
        // form was just fixed to stop showing.
        const thanks = form.dataset.thanks;
        if (thanks) window.location.assign(thanks);
      } catch {
        errorBox.classList.remove('hidden');
      } finally {
        setBusy(false);
      }
    });
  }
</script>
