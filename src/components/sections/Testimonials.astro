---
import SectionHeading from '../SectionHeading.astro';
import { getContent, sectionIds, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).testimonials;
---

{/*
  Nothing renders until a real quote exists. Inventing one would be a lie told
  in a client's name, and three empty dashed boxes on the landing page were not
  the honest alternative they looked like — they advertised having no clients.
  The Guarantees section stands in that space instead; this returns on its own
  the moment `testimonials.items` has something in it.
*/}
{
  t.items.length > 0 && (
<section
  id={sectionIds.testimonials}
  class="relative overflow-hidden py-20 sm:py-28"
>
  <div class="glow right-[-10rem] top-1/4 size-[24rem] bg-accent-alt/10" aria-hidden="true"></div>

  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {
        t.items.map((testimonial, index) => (
          <figure class="card card-hover flex flex-col" data-reveal data-reveal-delay={index * 80}>
            <blockquote class="grow text-sm leading-relaxed text-fg-muted">
              <p>“{testimonial.quote}”</p>
            </blockquote>
            <figcaption class="mt-6 border-t border-border pt-5">
              <p class="font-display text-sm font-semibold text-fg">{testimonial.name}</p>
              <p class="mt-0.5 text-xs text-fg-subtle">{testimonial.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
  )
}
