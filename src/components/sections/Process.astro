---
import SectionHeading from '../SectionHeading.astro';
import { getContent, sectionIds, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).process;
---

{/*
  `overflow-clip`, not `overflow-hidden`, and the difference is load-bearing.
  Both clip the glow to the section. But `hidden` also makes the element a
  scroll container, and `animation-timeline: view()` resolves against the
  nearest scrollport — so the spine below measured its progress through a box
  that never scrolls and sat frozen at whatever value it started on. `clip`
  clips without creating a scroll container, so the timeline finds the document.
*/}
<section id={sectionIds.process} class="relative overflow-clip py-20 sm:py-28">
  <div class="glow left-[-10rem] top-1/3 size-[26rem] bg-accent/12" aria-hidden="true"></div>

  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <ol class="mx-auto mt-16 max-w-3xl">
      {
        t.steps.map((step, index) => (
          <li
            class="relative grid grid-cols-[auto_1fr] gap-x-5 gap-y-2 pb-10 last:pb-0"
            data-reveal
            data-reveal-delay={index * 70}
          >
            {/*
              One segment of the spine, from under this step's marker to the
              top of the next one. Omitted after the final step, which is what
              makes the line end on the last marker without anyone having to
              know how tall the last paragraph is.
            */}
            {index < t.steps.length - 1 && (
              <span class="spine-link absolute left-[1.375rem] top-12 bottom-0 w-px" aria-hidden="true" />
            )}

            <span class="grid size-11 place-items-center rounded-full border border-accent/30 bg-surface-raised font-display text-sm font-semibold text-accent-alt">
              {String(index + 1).padStart(2, '0')}
            </span>

            <h3 class="self-center text-lg font-semibold">{step.title}</h3>
            <p class="col-start-2 text-sm leading-relaxed text-fg-muted">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
