---
/**
 * The hero above claims the site is fast. This band proves it, using the
 * visitor's own browser to measure the page they are currently looking at.
 * Nothing here is baked in at build time.
 */
import Icon from '../Icon.astro';
import Stamp from '../Stamp.astro';
import { getContent, localeTags, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).liveMetrics;

// Point PageSpeed at the canonical URL, not at whichever host ran the build.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pageSpeedUrl = `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(canonical)}`;

const metrics = [
  { id: 'lcp', label: t.lcpLabel },
  { id: 'weight', label: t.weightLabel },
  { id: 'js', label: t.jsLabel },
];
---

{/* Nothing to show without scripting — the numbers only exist once measured. */}
<section
  class="js-only metrics-band py-10 sm:py-12"
  aria-labelledby="live-metrics-title"
  data-live-metrics
  data-locale={localeTags[locale]}
>
  <div class="container-page">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12" data-reveal>
      <div class="min-w-0 lg:max-w-xs">
        <h2 id="live-metrics-title" class="flex items-center gap-2 text-sm font-semibold text-fg">
          <Icon name="gauge" class="size-4 shrink-0 text-accent-alt" />
          {t.title}
        </h2>
        <p class="mt-1.5 text-xs leading-relaxed text-fg-subtle">{t.note}</p>
        {/*
          The one stamped claim on the site. These three figures are read out of
          the visitor's own Performance entries while they look at the page —
          there is a check that says so by name, which is the whole condition
          for a stamp being allowed here at all.
        */}
        <Stamp
          class="mt-3"
          label={t.stampLabel}
          detail={t.stampDetail}
          suite="metrics.mjs"
          check="measurement completes"
        />
      </div>

      {/* Subgrid keeps every label on one row and every value on the next, so a
          label that wraps on a narrow screen cannot knock the numbers out of
          line with each other. */}
      <dl class="grid grid-cols-3 grid-rows-[auto_auto] gap-x-4 gap-y-2 sm:gap-x-10 lg:ml-auto">
        {
          metrics.map((metric) => (
            <div class="row-span-2 grid min-w-0 grid-rows-subgrid">
              <dt class="text-[0.7rem] uppercase leading-tight tracking-[0.12em] text-fg-subtle">
                {metric.label}
              </dt>
              <dd class="metric-figure self-end" data-metric={metric.id}>
                {t.pending}
              </dd>
            </div>
          ))
        }
      </dl>

      <a
        href={pageSpeedUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost shrink-0 text-sm"
      >
        {t.verify}
        <Icon name="arrow-right" class="size-4" />
      </a>
    </div>

    {/*
      Kilobytes are a developer's unit. This row says what the number means to
      somebody running a business, and names the benchmark it is measured
      against — an unsourced "N times lighter" is a boast, not a measurement.
    */}
    <p
      class="mt-8 flex flex-wrap items-baseline justify-center gap-x-2 gap-y-1 border-t border-border pt-5 text-center text-xs leading-relaxed text-fg-subtle"
      data-verdict-row
    >
      <span data-verdict data-template={t.verdict}>{t.verdictPending}</span>
      <a
        href={t.sourceHref}
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-4 hover:no-underline"
        data-verdict-source
      >
        {t.sourceLabel}
      </a>
    </p>
  </div>
</section>

<script>
  const band = document.querySelector<HTMLElement>('[data-live-metrics]');

  if (band && typeof performance?.getEntriesByType === 'function') {
    const locale = band.dataset.locale ?? 'ro';
    const kilobytes = (bytes: number) =>
      `${new Intl.NumberFormat(locale).format(Math.round(bytes / 1024))} kB`;
    const seconds = (ms: number) =>
      `${new Intl.NumberFormat(locale, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(ms / 1000)} s`;

    const set = (name: string, value: string) => {
      const cell = band.querySelector(`[data-metric="${name}"]`);
      if (cell) cell.textContent = value;
    };

    /**
     * The median web page weighs about 2.7 MB (HTTP Archive, page-weight
     * report, 2025 — linked next to the sentence this feeds). Written here as
     * one constant rather than several, so the figure and its source cannot
     * drift apart, and rounded to whole multiples: a page that is "4.37 times
     * lighter" is claiming a precision the benchmark does not have.
     */
    const MEDIAN_PAGE_BYTES = 2_700 * 1024;

    const setVerdict = (bytes: number) => {
      const cell = band.querySelector<HTMLElement>('[data-verdict]');
      if (!cell || bytes <= 0) return;
      const times = Math.round(MEDIAN_PAGE_BYTES / bytes);
      if (times < 2) return; // Nothing worth claiming; leave the pending text.
      cell.textContent = (cell.dataset.template ?? '').replace('{times}', String(times));
    };

    // The moment the page looked finished, as Google measures it.
    let lcp = 0;
    try {
      new PerformanceObserver((list) => {
        const entries = list.getEntries();
        lcp = entries[entries.length - 1]?.startTime ?? lcp;
      }).observe({ type: 'largest-contentful-paint', buffered: true });
    } catch {
      // Older Safari has no LCP; the load timestamp stands in below.
    }

    const report = () => {
      const nav = performance.getEntriesByType('navigation')[0] as
        | PerformanceNavigationTiming
        | undefined;
      const resources = performance.getEntriesByType('resource') as PerformanceResourceTiming[];

      // decodedBodySize rather than transferSize: it reads the same whether or
      // not the visit hit the cache, so a returning visitor is not shown a
      // meaningless "2 kB". It also keeps the JS figure below in the same unit.
      let total = nav?.decodedBodySize ?? 0;
      let js = 0;

      for (const resource of resources) {
        total += resource.decodedBodySize || 0;
        if (resource.initiatorType === 'script') js += resource.decodedBodySize || 0;
      }

      // Inline scripts ship inside the HTML, so they are already counted in
      // `total`; measuring their text just breaks out how much of the page is
      // JavaScript. JSON-LD is data, not code, so it stays out.
      const encoder = new TextEncoder();
      for (const script of document.querySelectorAll('script')) {
        if (!script.src && script.type !== 'application/ld+json') {
          js += encoder.encode(script.textContent ?? '').length;
        }
      }

      const paint = lcp || nav?.domContentLoadedEventEnd || 0;
      if (paint) set('lcp', seconds(paint));
      if (total) {
        set('weight', kilobytes(total));
        setVerdict(total);
      }
      if (js) set('js', kilobytes(js));
      band.dataset.ready = 'true';
    };

    // Measure once the page has gone quiet rather than on `load`, which also
    // gives LCP time to settle on its final candidate.
    // Safari only shipped requestIdleCallback in 17, hence the timeout fallback.
    const settle = () => {
      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(report, { timeout: 1200 });
      } else {
        window.setTimeout(report, 400);
      }
    };

    // Idle is still not late enough for everything: the favicon is fetched at
    // low priority and reliably lands after it, leaving the total a kilobyte
    // short. Rather than publish a number we know is wrong, keep watching and
    // correct it. Five seconds is well past anything a static page will fetch.
    try {
      const watcher = new PerformanceObserver(() => {
        if (band.dataset.ready === 'true') report();
      });
      watcher.observe({ type: 'resource', buffered: false });
      window.setTimeout(() => watcher.disconnect(), 5000);
    } catch {
      // No resource timing: the idle reading stands.
    }

    if (document.readyState === 'complete') settle();
    else window.addEventListener('load', settle, { once: true });
  }
</script>
