---
/**
 * The colophon.
 *
 * The site's whole argument is "measured, not claimed", and this page turns
 * that on the site itself: what it was built from, what holds it, and — the
 * half that makes it worth publishing — what it has no way of knowing.
 *
 * The one rule: nothing here may state a result the build cannot know. The
 * build runs before the test suite, so the page says how many checks the suite
 * CONTAINS and says out loud why that is not a pass rate. Writing "1026 checks
 * passing" would have been one sentence of work and exactly the kind of claim
 * the rest of the site spends its time refusing to make.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { getContent, locales, type Locale } from '../i18n';
import { build, SUITE_CHECKS } from '../data/build';
import { colophonPath, contactPath } from '../data/demo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).colophon;

const alternates = Object.fromEntries(
  locales.map((code) => [code, colophonPath(code)]),
) as Partial<Record<Locale, string>>;

const checks = new Intl.NumberFormat(locale === 'en' ? 'en-GB' : 'ro-RO').format(SUITE_CHECKS);
---

<Base locale={locale} title={t.metaTitle} description={t.metaDescription} alternates={alternates}>
  <Header locale={locale} />

  <main id="main" class="relative overflow-clip">
    <div
      class="glow left-1/2 top-[-8rem] size-[34rem] -translate-x-1/2 bg-accent/14"
      aria-hidden="true"
    >
    </div>

    <div class="container-page py-32 sm:py-40">
      <div class="mx-auto max-w-3xl">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="mt-4 text-3xl font-semibold sm:text-4xl md:text-5xl md:leading-[1.1]">
          {t.title}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-fg-muted">{t.lead}</p>

        {/* --- Which commit --- */}
        <section class="mt-16" data-reveal>
          <h2 class="font-display text-xl font-semibold">{t.commitTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-fg-muted">{t.commitBody}</p>

          <div class="mt-5 rounded-2xl border border-border bg-surface-raised/60 p-6">
            <p class="text-xs uppercase tracking-wider text-fg-subtle">{t.commitLabel}</p>
            {
              build.commit ? (
                <a
                  class="mt-1 block font-mono text-lg break-all text-accent-alt underline underline-offset-4 hover:no-underline"
                  href={build.commitUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-colophon-commit
                >
                  {build.shortCommit}
                </a>
              ) : (
                <p class="mt-1 text-sm text-fg-muted" data-colophon-commit>
                  {t.commitUnknown}
                </p>
              )
            }
            <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
              <a
                href="/version.txt"
                class="text-fg-muted underline underline-offset-4 hover:text-accent-alt"
              >
                {t.versionLink}
              </a>
              <a
                href={build.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-fg-muted underline underline-offset-4 hover:text-accent-alt"
              >
                {t.repoLink}
              </a>
            </p>
          </div>
        </section>

        {/* --- The checks. The wording here is the point of the page. --- */}
        <section class="mt-14" data-reveal>
          <h2 class="font-display text-xl font-semibold">{t.checksTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-fg-muted">{t.checksBody}</p>

          <div class="mt-5 rounded-2xl border border-border bg-surface-raised/60 p-6">
            <p class="font-display text-4xl font-semibold text-gradient" data-colophon-checks>
              {checks}
            </p>
            <p class="mt-1 text-sm text-fg-muted">{t.checksLabel}</p>
            <p class="mt-4 text-xs leading-relaxed text-fg-subtle" data-colophon-note>
              {t.checksNote}
            </p>
          </div>
        </section>

        {/* --- Budgets --- */}
        <section class="mt-14" data-reveal>
          <h2 class="font-display text-xl font-semibold">{t.budgetsTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-fg-muted">{t.budgetsBody}</p>

          <dl
            class="mt-5 divide-y divide-border overflow-hidden rounded-2xl border border-border"
            data-colophon-budgets
          >
            {
              t.budgetRows.map((row) => (
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-6 py-4">
                  <dt class="text-sm text-fg-muted">{row.label}</dt>
                  <dd class="font-display text-sm font-semibold text-fg tabular-nums">{row.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        {/* --- CSP --- */}
        <section class="mt-14" data-reveal>
          <h2 class="font-display text-xl font-semibold">{t.cspTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-fg-muted">{t.cspBody}</p>
        </section>

        {/* --- The half that makes the page worth publishing --- */}
        <section class="mt-14" data-reveal>
          <h2 class="font-display text-xl font-semibold">{t.limitsTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-fg-muted">{t.limitsBody}</p>

          <ul class="mt-5 space-y-3" data-colophon-limits>
            {
              t.limits.map((limit) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-fg-muted">
                  <span
                    class="mt-2 size-1.5 shrink-0 rounded-full bg-border-strong"
                    aria-hidden="true"
                  />
                  <span>{limit}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <div class="rule-mark mt-16" aria-hidden="true"><span></span></div>

        <aside
          class="mt-10 flex flex-col items-start gap-5 rounded-2xl border border-accent/25 bg-linear-110 from-surface-raised to-surface p-8 sm:flex-row sm:items-center sm:justify-between"
        >
          <div>
            <h2 class="font-display text-xl font-semibold">{t.ctaTitle}</h2>
            <p class="mt-2 max-w-md text-sm text-fg-muted">{t.ctaBody}</p>
          </div>
          <a href={contactPath(locale, 'colophon')} class="btn btn-primary shrink-0 text-sm">
            {t.ctaButton}
            <Icon name="arrow-right" class="size-4" />
          </a>
        </aside>
      </div>
    </div>
  </main>

  <Footer locale={locale} />
</Base>
