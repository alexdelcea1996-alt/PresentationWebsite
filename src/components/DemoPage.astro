---
/**
 * The shell every demo sits in: hero, the demo itself, the explanation cards
 * and the call to action.
 *
 * Four demos now, of two kinds. Two are applications you play with; two are
 * complete example sites shown inside a browser frame. They share this shell so
 * a demo cannot drift into looking like a different site, and so the switcher
 * between them exists in exactly one place.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import BookingDemo from './BookingDemo.astro';
import StoreDemo from './StoreDemo.astro';
import DemoFrame from './DemoFrame.astro';
import { getContent, locales, type Locale } from '../i18n';
import {
  contactPath,
  demoPath,
  storeDemoPath,
  landingDemoPath,
  siteDemoPath,
  exampleLandingPath,
  exampleSitePath,
} from '../data/demo';

interface Props {
  locale: Locale;
  /** Which of the four demos this page carries. */
  app: 'bookings' | 'store' | 'landing' | 'site';
}

const { locale, app } = Astro.props;
const t = getContent(locale);

const framed = app === 'landing' || app === 'site';
const d = { bookings: t.demo, store: t.storeDemo, landing: t.landingDemo, site: t.siteDemo }[app];
const pathFor = {
  bookings: demoPath,
  store: storeDemoPath,
  landing: landingDemoPath,
  site: siteDemoPath,
}[app];

const alternates = Object.fromEntries(
  locales.map((code) => [code, pathFor(code)]),
) as Partial<Record<Locale, string>>;

// Which offer this demo argues for, so the form arrives already knowing.
const typeFor = { bookings: 'webapp', store: 'shop', landing: 'landing', site: 'presentation' }[app];
const contactAnchor = contactPath(locale, typeFor, `demo-${app}`);

const tabs = [
  { id: 'landing', href: landingDemoPath(locale), label: t.demoNav.landing },
  { id: 'site', href: siteDemoPath(locale), label: t.demoNav.site },
  { id: 'store', href: storeDemoPath(locale), label: t.demoNav.store },
  { id: 'bookings', href: demoPath(locale), label: t.demoNav.bookings },
] as const;

// The framed examples: where the iframe points, and what its address bar says.
// The fake URL is the invented company's, not this site's — showing my own
// domain in the chrome would undercut the illusion the frame exists to create.
const frame = {
  landing: {
    src: exampleLandingPath(locale),
    displayUrl: locale === 'en' ? 'rindea.example/workshop' : 'rindea.example/atelier',
  },
  site: {
    src: exampleSitePath(locale),
    displayUrl: 'termoflux.example',
  },
}[app === 'site' ? 'site' : 'landing'];
---

<Base
  locale={locale}
  title={d.metaTitle}
  description={d.metaDescription}
  alternates={alternates}
  breadcrumb={[{ name: d.title, href: pathFor(locale) }]}
>
  <Header locale={locale} />

  <main id="main">
    <section class="relative overflow-hidden pt-32 pb-16 sm:pt-40">
      <div
        class="glow left-1/2 top-[-6rem] size-[34rem] -translate-x-1/2 bg-accent/20"
        aria-hidden="true"
      >
      </div>

      <div class="container-page">
        <div class="max-w-3xl">
          <p class="eyebrow">{d.eyebrow}</p>
          <h1 class="mt-4 text-3xl font-semibold sm:text-4xl md:text-5xl md:leading-[1.1]">
            {d.title}
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-fg-muted">{d.lead}</p>
        </div>

        <nav class="mt-8 flex flex-wrap items-center gap-2" aria-label={t.demoNav.label}>
          {
            tabs.map((tab) => (
              <a
                href={tab.href}
                class="demo-chip"
                aria-current={tab.id === app ? 'page' : undefined}
                data-demo-tab={tab.id}
              >
                {tab.label}
              </a>
            ))
          }
        </nav>

        <div class="mt-10" data-reveal>
          {
            app === 'store' ? (
              <StoreDemo locale={locale} />
            ) : app === 'bookings' ? (
              <BookingDemo locale={locale} />
            ) : (
              <DemoFrame locale={locale} src={frame.src} displayUrl={frame.displayUrl} />
            )
          }
        </div>

        {
          framed && (
            <div class="mt-10 max-w-3xl" data-reveal>
              <p class="text-sm leading-relaxed text-fg-subtle" data-demo-disclaimer>
                {d.disclaimer}
              </p>

              <h2 class="mt-10 font-display text-lg font-semibold">
                {'lookForTitle' in d && d.lookForTitle}
              </h2>
              <ul class="mt-4 space-y-3">
                {'lookFor' in d &&
                  d.lookFor.map((item) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-fg-muted">
                      <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-accent/10 text-accent-alt">
                        <Icon name="check" class="size-3" />
                      </span>
                      <span data-demo-lookfor>{item}</span>
                    </li>
                  ))}
              </ul>
            </div>
          )
        }

        <div class="mt-16 grid max-w-4xl gap-6 sm:grid-cols-2">
          <div class="card" data-reveal>
            <h2 class="font-display text-lg font-semibold">{d.whyTitle}</h2>
            <p class="mt-3 text-sm leading-relaxed text-fg-muted">{d.whyBody}</p>
          </div>
          <div class="card" data-reveal data-reveal-delay="80">
            <h2 class="font-display text-lg font-semibold">{d.builtTitle}</h2>
            <p class="mt-3 text-sm leading-relaxed text-fg-muted">{d.builtBody}</p>
          </div>
        </div>

        <a href={contactAnchor} class="btn btn-primary mt-10" data-reveal>
          {d.cta}
          <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>
