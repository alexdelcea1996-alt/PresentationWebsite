---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import BookingDemo from './BookingDemo.astro';
import { getContent, sectionIds, locales, type Locale } from '../i18n';
import { demoPath } from '../data/demo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const d = t.demo;

const alternates = Object.fromEntries(
  locales.map((code) => [code, demoPath(code)]),
) as Partial<Record<Locale, string>>;

const contactAnchor = `${getRelativeLocaleUrl(locale)}#${sectionIds.contact}`.replace(/\/{2,}/g, '/');
---

<Base
  locale={locale}
  title={d.metaTitle}
  description={d.metaDescription}
  alternates={alternates}
>
  <Header locale={locale} />

  <main id="main">
    <section class="relative overflow-hidden pt-32 pb-16 sm:pt-40">
      <div
        class="glow left-1/2 top-[-6rem] size-[34rem] -translate-x-1/2 bg-accent/20"
        aria-hidden="true"
      >
      </div>

      <div class="container-page">
        <div class="max-w-3xl">
          <p class="eyebrow">{d.eyebrow}</p>
          <h1 class="mt-4 text-3xl font-semibold sm:text-4xl md:text-5xl md:leading-[1.1]">
            {d.title}
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-fg-muted">{d.lead}</p>
        </div>

        <div class="mt-12" data-reveal>
          <BookingDemo locale={locale} />
        </div>

        <div class="mt-16 grid max-w-4xl gap-6 sm:grid-cols-2">
          <div class="card" data-reveal>
            <h2 class="font-display text-lg font-semibold">{d.whyTitle}</h2>
            <p class="mt-3 text-sm leading-relaxed text-fg-muted">{d.whyBody}</p>
          </div>
          <div class="card" data-reveal data-reveal-delay="80">
            <h2 class="font-display text-lg font-semibold">{d.builtTitle}</h2>
            <p class="mt-3 text-sm leading-relaxed text-fg-muted">{d.builtBody}</p>
          </div>
        </div>

        <a href={contactAnchor} class="btn btn-primary mt-10" data-reveal>
          {d.cta}
          <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>
