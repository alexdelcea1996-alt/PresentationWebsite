---
/**
 * The shell both playable demos sit in: hero, the app itself, the two
 * explanation cards and the call to action.
 *
 * Shared rather than copied so a second demo cannot drift into looking like a
 * different site — and so the switcher between them exists in exactly one place.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import BookingDemo from './BookingDemo.astro';
import StoreDemo from './StoreDemo.astro';
import { getContent, sectionIds, locales, type Locale } from '../i18n';
import { demoPath, storeDemoPath } from '../data/demo';

interface Props {
  locale: Locale;
  /** Which of the two apps this page carries. */
  app: 'bookings' | 'store';
}

const { locale, app } = Astro.props;
const t = getContent(locale);
const d = app === 'store' ? t.storeDemo : t.demo;
const pathFor = app === 'store' ? storeDemoPath : demoPath;

const alternates = Object.fromEntries(
  locales.map((code) => [code, pathFor(code)]),
) as Partial<Record<Locale, string>>;

const contactAnchor = `${getRelativeLocaleUrl(locale)}#${sectionIds.contact}`.replace(/\/{2,}/g, '/');

const tabs = [
  { id: 'bookings', href: demoPath(locale), label: t.demoNav.bookings },
  { id: 'store', href: storeDemoPath(locale), label: t.demoNav.store },
] as const;
---

<Base locale={locale} title={d.metaTitle} description={d.metaDescription} alternates={alternates}>
  <Header locale={locale} />

  <main id="main">
    <section class="relative overflow-hidden pt-32 pb-16 sm:pt-40">
      <div
        class="glow left-1/2 top-[-6rem] size-[34rem] -translate-x-1/2 bg-accent/20"
        aria-hidden="true"
      >
      </div>

      <div class="container-page">
        <div class="max-w-3xl">
          <p class="eyebrow">{d.eyebrow}</p>
          <h1 class="mt-4 text-3xl font-semibold sm:text-4xl md:text-5xl md:leading-[1.1]">
            {d.title}
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-fg-muted">{d.lead}</p>
        </div>

        <nav class="mt-8 flex flex-wrap items-center gap-2" aria-label={t.demoNav.label}>
          {
            tabs.map((tab) => (
              <a
                href={tab.href}
                class="demo-chip"
                aria-current={tab.id === app ? 'page' : undefined}
                data-demo-tab={tab.id}
              >
                {tab.label}
              </a>
            ))
          }
        </nav>

        <div class="mt-10" data-reveal>
          {app === 'store' ? <StoreDemo locale={locale} /> : <BookingDemo locale={locale} />}
        </div>

        <div class="mt-16 grid max-w-4xl gap-6 sm:grid-cols-2">
          <div class="card" data-reveal>
            <h2 class="font-display text-lg font-semibold">{d.whyTitle}</h2>
            <p class="mt-3 text-sm leading-relaxed text-fg-muted">{d.whyBody}</p>
          </div>
          <div class="card" data-reveal data-reveal-delay="80">
            <h2 class="font-display text-lg font-semibold">{d.builtTitle}</h2>
            <p class="mt-3 text-sm leading-relaxed text-fg-muted">{d.builtBody}</p>
          </div>
        </div>

        <a href={contactAnchor} class="btn btn-primary mt-10" data-reveal>
          {d.cta}
          <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>
