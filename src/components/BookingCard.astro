---
/**
 * The booking offer as a card: a line of explanation and the button. The
 * calendar itself is `BookingDialog`, which this card brings along — the card is
 * only used where no other booking link shares the page.
 */
import Icon from './Icon.astro';
import BookingDialog from './BookingDialog.astro';
import BookingLink from './BookingLink.astro';
import { getContent, type Locale } from '../i18n';
import { bookingUrl } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).booking;
---

{
  bookingUrl() && (
    <>
      <div class="mt-6 rounded-xl border border-accent/30 bg-accent/5 p-4">
        <p class="flex items-start gap-2.5 text-sm font-semibold text-fg">
          <Icon name="calendar" class="mt-0.5 size-4 shrink-0 text-accent-alt" />
          {t.title}
        </p>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">{t.body}</p>

        {/*
          A real link first: without JavaScript, or if anything about the embed
          fails, this simply opens the booking page in a new tab.
        */}
        <BookingLink class="btn btn-primary mt-4 w-full text-sm" where="card">
          {t.cta}
          <Icon name="arrow-right" class="size-4" />
        </BookingLink>
      </div>

      <BookingDialog locale={locale} />
    </>
  )
}
