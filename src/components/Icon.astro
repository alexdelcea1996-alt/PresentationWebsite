---
/**
 * Inline SVG icons. Kept as markup (not an icon font or sprite request) so the
 * page needs zero extra network round-trips. The paths themselves live in
 * `src/data/icons.ts`, shared with the booking demo's client script.
 */
import { iconPaths, type IconName } from '../data/icons';

export type { IconName };

interface Props extends astroHTML.JSX.SVGAttributes {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-6', ...attrs } = Astro.props;
---

<svg
  {...attrs}
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={iconPaths[name]}
/>
