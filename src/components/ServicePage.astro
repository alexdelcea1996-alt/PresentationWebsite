---
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { getContent, sectionIds, type Locale } from '../i18n';
import { getServiceTranslations, servicePath, type ServicePage } from '../data/services';
import { demoForService } from '../data/demo';

interface Props {
  locale: Locale;
  entry: ServicePage;
}

const { locale, entry } = Astro.props;
const t = getContent(locale);
const d = entry.data;
const { Content } = await render(entry);

// hreflang must point at this service in the other language, not the home page.
const translations = await getServiceTranslations(entry);
const alternates = Object.fromEntries(
  Object.entries(translations).map(([code, translated]) => [
    code,
    servicePath(code as Locale, translated.data.urlSlug),
  ]),
) as Partial<Record<Locale, string>>;

const home = getRelativeLocaleUrl(locale);
const anchor = (id: string) => `${home}#${id}`.replace(/\/{2,}/g, '/');

// The questions are already written and already on the page — this just states
// them in the form search engines read. Built as an object and serialised by
// JSON.stringify, because the answers contain both „…" and "…" quotes and a
// hand-assembled JSON string would break on them.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Base
  locale={locale}
  title={d.metaTitle}
  description={d.metaDescription}
  alternates={alternates}
  extraSchema={faqSchema}
>
  <Header locale={locale} />

  <main id="main">
    <article>
      <!-- Hero -->
      <section class="relative overflow-hidden pt-32 pb-16 sm:pt-40">
        <div
          class="glow left-1/2 top-[-6rem] size-[36rem] -translate-x-1/2 bg-accent/20"
          aria-hidden="true"
        >
        </div>

        <div class="container-page">
          <a
            href={anchor(sectionIds.services)}
            class="inline-flex items-center gap-2 text-sm font-medium text-fg-muted transition-colors hover:text-accent-alt"
          >
            <Icon name="arrow-right" class="size-4 rotate-180" />
            {t.services.backToOverview}
          </a>

          <div class="mt-8 max-w-3xl">
            <p class="eyebrow">{d.eyebrow}</p>
            <h1 class="mt-4 text-3xl font-semibold sm:text-4xl md:text-5xl md:leading-[1.1]">
              {d.title}
            </h1>
            <p class="mt-6 text-lg leading-relaxed text-fg-muted">{d.lead}</p>

            <div class="mt-8 flex flex-wrap gap-3">
              <a href={anchor(sectionIds.contact)} class="btn btn-primary text-sm">
                {d.ctaButton}
                <Icon name="arrow-right" class="size-4" />
              </a>
              <a href={anchor(sectionIds.estimate)} class="btn btn-ghost text-sm">
                {t.configurator.eyebrow}
              </a>
              {/* Only where a demo actually shows that offer — under "optimisation"
                  a playable app would promise the wrong thing. */}
              {demoForService(locale, d.key) && (
                <a href={demoForService(locale, d.key)} class="btn btn-ghost text-sm" data-demo-cta>
                  {t.services.demoCta}
                  <Icon name="arrow-right" class="size-4" />
                </a>
              )}
            </div>
          </div>

          <dl
            class="mt-14 grid max-w-3xl gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-3"
          >
            {
              d.highlights.map((highlight) => (
                <div class="bg-surface-raised px-6 py-5">
                  <dt class="text-xs uppercase tracking-wider text-fg-subtle">{highlight.label}</dt>
                  <dd class="mt-1.5 font-display text-lg font-semibold text-fg">
                    {highlight.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- Long-form argument -->
      <section class="pb-4">
        <div class="container-page">
          <div
            class="max-w-3xl text-base leading-relaxed text-fg-muted [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-fg [&_p]:mt-4 [&_strong]:text-fg"
          >
            <Content />
          </div>
        </div>
      </section>

      <!-- What's included -->
      <section class="py-16 sm:py-20">
        <div class="container-page">
          <h2 class="font-display text-2xl font-semibold sm:text-3xl" data-reveal>
            {d.includesTitle}
          </h2>

          <div class="mt-10 grid gap-5 md:grid-cols-2">
            {
              d.includes.map((item, index) => (
                <div class="card" data-reveal data-reveal-delay={index * 50}>
                  <h3 class="flex items-start gap-2.5 font-display text-base font-semibold">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-alt" />
                    {item.title}
                  </h3>
                  <p class="mt-3 pl-7 text-sm leading-relaxed text-fg-muted">{item.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Fit / not fit -->
      <section class="pb-16 sm:pb-20">
        <div class="container-page">
          <div class="grid gap-6 lg:grid-cols-2">
            <div class="card border-accent/30 bg-accent/5" data-reveal>
              <h2 class="font-display text-lg font-semibold text-fg">{d.idealForTitle}</h2>
              <ul class="mt-5 space-y-3">
                {
                  d.idealFor.map((item) => (
                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-fg-muted">
                      <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-alt" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="card" data-reveal data-reveal-delay="80">
              <h2 class="font-display text-lg font-semibold text-fg">{d.notForTitle}</h2>
              <ul class="mt-5 space-y-3">
                {
                  d.notFor.map((item) => (
                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-fg-muted">
                      <Icon name="close" class="mt-0.5 size-4 shrink-0 text-fg-subtle" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="pb-16 sm:pb-20">
        <div class="container-page">
          <h2 class="font-display text-2xl font-semibold sm:text-3xl" data-reveal>{d.faqTitle}</h2>

          <div class="mt-10 max-w-3xl space-y-3">
            {
              d.faq.map((item, index) => (
                <details
                  class="group card cursor-pointer [&[open]]:border-accent/40"
                  data-reveal
                  data-reveal-delay={index * 40}
                >
                  <summary class="flex list-none items-start justify-between gap-4 font-display text-base font-semibold text-fg marker:hidden">
                    {item.question}
                    <span
                      class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full border border-border-strong text-fg-subtle transition-transform group-open:rotate-45"
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M12 5v14M5 12h14" />
                      </svg>
                    </span>
                  </summary>
                  <p class="mt-4 text-sm leading-relaxed text-fg-muted">{item.answer}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Closing CTA -->
      <section class="pb-20 sm:pb-28">
        <div class="container-page">
          <aside
            class="relative overflow-hidden rounded-3xl border border-accent/25 bg-linear-110 from-surface-raised to-surface p-8 sm:p-12"
            data-reveal
          >
            <div class="glow right-[-6rem] top-[-6rem] size-[22rem] bg-accent/20" aria-hidden="true">
            </div>
            <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="font-display text-2xl font-semibold">{d.ctaTitle}</h2>
                <p class="mt-3 max-w-lg text-sm leading-relaxed text-fg-muted">{d.ctaBody}</p>
              </div>
              <a href={anchor(sectionIds.contact)} class="btn btn-primary shrink-0">
                {d.ctaButton}
                <Icon name="arrow-right" class="size-4" />
              </a>
            </div>
          </aside>
        </div>
      </section>
    </article>
  </main>

  <Footer locale={locale} />
</Base>
