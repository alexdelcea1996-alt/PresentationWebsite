---
/**
 * A browser window with a real page inside it — and a way to put the visitor's
 * own name on that page.
 *
 * The example sites are framed rather than embedded inline for one reason: they
 * bring their own stylesheet and their own type stack, and inlining them would
 * mean either bleeding this site's design into the example or fighting it with
 * specificity forever. An iframe gives the example a document of its own — which
 * is also what makes the width switch honest, since resizing the frame makes the
 * example's own media queries fire exactly as they would on a phone.
 *
 * Framing our own pages needed `frame-ancestors 'self'` instead of `'none'`, and
 * `X-Frame-Options: SAMEORIGIN` instead of `DENY`. Third-party framing — the
 * actual clickjacking risk — is still refused; see `scripts/build-headers.mjs`.
 *
 * Everything below is per-instance. The first version reached for the document
 * with `document.querySelector`, which was fine while exactly one frame existed
 * on the site and would have silently wired the second one to the first the
 * moment a frame appeared beside it.
 */
import Icon from './Icon.astro';
import { getContent, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Address of the page to frame, and the one the "open full" link uses. */
  src: string;
  /** Shown in the fake address bar. Not a link — it is a picture of a URL. */
  displayUrl: string;
  /** Where the "I want the real thing" button goes. Omitted hides it. */
  ctaHref?: string;
  /** Personalisation is the demo pages' party trick; other placements opt out. */
  personalize?: boolean;
}

const { locale, src, displayUrl, ctaHref, personalize = true } = Astro.props;
const t = getContent(locale).demoFrame;
---

<div class="demo-frame" data-demo-frame data-width="desktop">
  {
    personalize && (
      <div class="card mb-5" data-personalize>
        {/* h2, not h3: on the demo pages this is the first heading under the
            page title, and skipping a level is what axe caught here. In the
            portfolio it sits under an h3 heading of its own — see below. */}
        <h2 class="font-display text-base font-semibold text-fg">{t.personalizeTitle}</h2>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">{t.personalizeBody}</p>

        <div class="mt-4 grid gap-4 sm:grid-cols-[1.4fr_1fr] sm:items-start">
          <div>
            <label class="demo-field" for={`brand-${displayUrl}`}>
              {t.nameLabel}
              <input
                id={`brand-${displayUrl}`}
                type="text"
                maxlength="28"
                autocomplete="organization"
                placeholder={t.namePlaceholder}
                data-brand-input
              />
            </label>
          </div>

          <div role="group" aria-label={t.colourLabel}>
            <p class="demo-field">{t.colourLabel}</p>
            <div class="mt-1.5 flex flex-wrap gap-2">
              {
                t.colours.map((colour, index) => (
                  <button
                    type="button"
                    class="brand-swatch"
                    data-brand-colour={colour.value}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    aria-label={colour.label}
                    title={colour.label}
                  >
                    <span class="brand-swatch-dot" data-swatch-dot={colour.id} />
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          {
            ctaHref && (
              <a href={ctaHref} class="btn btn-primary text-sm" data-personalize-cta>
                {t.cta}
                <Icon name="arrow-right" class="size-4" />
              </a>
            )
          }
          <button type="button" class="demo-chip hidden" data-brand-reset>
            {t.reset}
          </button>
        </div>
      </div>
    )
  }

  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-1.5" role="group" aria-label={t.viewLabel}>
      <button type="button" class="demo-chip" data-frame-width="desktop" aria-pressed="true">
        {t.desktop}
      </button>
      <button type="button" class="demo-chip" data-frame-width="mobile" aria-pressed="false">
        {t.mobile}
      </button>
    </div>

    <a
      href={src}
      target="_blank"
      rel="noopener"
      class="text-sm text-accent-alt underline underline-offset-4 hover:no-underline"
      data-frame-open
    >
      {t.openFull}
      <Icon name="arrow-right" class="inline size-3.5 align-[-2px]" />
    </a>
  </div>

  <div class="mt-4 flex justify-center">
    <div class="demo-frame-shell" data-frame-shell>
      <div class="demo-frame-chrome">
        <span class="demo-frame-dot" aria-hidden="true"></span>
        <span class="demo-frame-dot" aria-hidden="true"></span>
        <span class="demo-frame-dot" aria-hidden="true"></span>
        {/* Never rewritten when the visitor personalises the example: showing
            somebody a URL they do not own would be the one dishonest part. */}
        <span class="demo-frame-url">{displayUrl}</span>
      </div>

      <iframe src={src} title={t.frameTitle} loading="lazy" class="demo-frame-view"></iframe>
    </div>
  </div>
</div>

<script>
  /**
   * One controller per frame. Two frames can live on one page — the landing
   * page carries one and the demo pages carry another — so nothing here may
   * reach past its own root.
   */
  for (const frame of document.querySelectorAll<HTMLElement>('[data-demo-frame]')) {
    const iframe = frame.querySelector<HTMLIFrameElement>('iframe')!;

    // --- Width switch. The iframe keeps its document; only the viewport it
    // believes it has changes, so the example's own breakpoints do the work.
    const widthButtons = frame.querySelectorAll<HTMLButtonElement>('[data-frame-width]');
    for (const button of widthButtons) {
      button.addEventListener('click', () => {
        frame.dataset.width = button.dataset.frameWidth ?? 'desktop';
        for (const other of widthButtons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
      });
    }

    // --- Personalisation
    const brandInput = frame.querySelector<HTMLInputElement>('[data-brand-input]');
    if (!brandInput) continue;

    const swatches = frame.querySelectorAll<HTMLButtonElement>('[data-brand-colour]');
    const resetButton = frame.querySelector<HTMLButtonElement>('[data-brand-reset]');
    let brand = '';
    let accent = '';

    /**
     * The example lives in its own document, so the only way in is postMessage.
     * Targeted at this exact origin rather than '*': the payload is harmless,
     * but broadcasting to any origin is a habit that stops being harmless the
     * first time the frame points somewhere else.
     */
    const push = () => {
      iframe.contentWindow?.postMessage(
        { type: 'demo-brand', brand, accent },
        window.location.origin,
      );
      resetButton?.classList.toggle('hidden', !brand && !accent);
    };

    brandInput.addEventListener('input', () => {
      brand = brandInput.value.trim();
      push();
    });

    for (const swatch of swatches) {
      swatch.addEventListener('click', () => {
        accent = swatch.dataset.brandColour ?? '';
        for (const other of swatches) {
          other.setAttribute('aria-pressed', String(other === swatch));
        }
        push();
      });
    }

    resetButton?.addEventListener('click', () => {
      brand = '';
      accent = '';
      brandInput.value = '';
      swatches.forEach((s, index) => s.setAttribute('aria-pressed', String(index === 0)));
      push();
      brandInput.focus();
    });

    // The business-website example is three pages: every navigation inside the
    // frame loads a fresh document that knows nothing about what was typed.
    iframe.addEventListener('load', () => {
      if (brand || accent) push();
    });
  }
</script>

<style>
  /*
   * The height lives here rather than on a `style` attribute. The CSP has no
   * `unsafe-inline` for styles, so the browser drops style attributes silently
   * — the first version of this component set the height that way and the
   * frame collapsed to the 150px iframe default, with only a console warning
   * to show for it. A viewport-relative height is better anyway: the example
   * scrolls inside the frame, which is what a browser window does.
   */
  .demo-frame-shell {
    width: 100%;
    max-width: 100%;
    border: 1px solid var(--color-border-strong, #2a3550);
    border-radius: 0.75rem;
    overflow: hidden;
    background: #fff;
    transition: max-width 0.35s ease;
  }

  /*
    The frame turns to face the reader as they reach it.

    Product shots are the one place a page is allowed to show something at an
    angle, and what is at an angle here is not a picture of a site — it is the
    site, live, in an iframe, three pages deep and clickable. Turning it costs
    one keyframe and says the thing a caption would have had to claim.

    It ends flat, on purpose and exactly: an iframe is rasterised through
    whatever transform it carries, so anything left of the rotation at rest
    would be a permanently soft screenshot of a working page.

    The range is `cover` rather than `entry` for one reason, and it is not the
    one first written here: measured at 900, 700 and 600px of viewport, the two
    produce identical numbers, because the frame is fluid and never ends up
    taller than the screen it is on. What `cover` buys is that it stays correct
    if it ever does. `entry` runs from an element first touching the viewport
    to it being wholly inside, which for an element taller than the viewport
    never happens — the range would not complete, and the frame would sit
    turned away the whole time anybody looked at it.

    Gated on scroll-driven animation support and on the reader not having asked
    for less motion. Without either it is the flat frame it has always been.
  */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @keyframes frame-face {
        from {
          transform: perspective(1600px) translate3d(0, 0, -90px) rotateY(-10deg) rotateX(3deg);
        }
      }

      .demo-frame-shell {
        animation-name: frame-face;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 0% cover 32%;
      }
    }
  }

  [data-width='mobile'] .demo-frame-shell {
    max-width: 24rem;
  }

  .demo-frame-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    background: var(--color-surface-hover, #172038);
    border-bottom: 1px solid var(--color-border, #232d47);
  }

  .demo-frame-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-border-strong, #37425f);
    flex: none;
  }

  .demo-frame-url {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-fg-subtle, #8794ad);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .demo-frame-view {
    display: block;
    width: 100%;
    height: min(78vh, 680px);
    border: 0;
    background: #fff;
  }

  /*
   * The colour swatches. The dot's colour is the one thing that varies per
   * button, and a `style` attribute would be dropped by the CSP — so the five
   * values live here, keyed by the same ids the buttons render from.
   */
  .brand-swatch {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    transition: border-color 0.2s var(--ease-out-soft);
  }

  .brand-swatch[aria-pressed='true'] {
    border-color: var(--color-accent-alt);
  }

  .brand-swatch-dot {
    display: block;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
  }

  [data-swatch-dot='brown'] {
    background: #8a4a1d;
  }
  [data-swatch-dot='blue'] {
    background: #12508f;
  }
  [data-swatch-dot='green'] {
    background: #1f6b44;
  }
  [data-swatch-dot='plum'] {
    background: #6b2d5c;
  }
  [data-swatch-dot='ink'] {
    background: #2b3440;
  }
</style>
