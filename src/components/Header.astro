---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getContent, type Locale } from '../i18n';
import { site } from '../data/site';
import { blogIndexPath } from '../data/blog';
import { contactPath, demoPath } from '../data/demo';
import { estimatePath, pricingPath, projectsPath, servicesIndexPath } from '../data/pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const home = getRelativeLocaleUrl(locale);

/**
 * Seven links, seven pages.
 *
 * These used to be anchors into one very long front page, which meant the menu
 * described a document rather than a site: nothing was ever "the current page",
 * every entry led to the same address, and a reader who wanted the price list
 * arrived at the top of it. Now each entry goes where it says it goes, and the
 * one you are on can say so.
 */
const links = [
  { href: servicesIndexPath(locale), label: t.nav.services },
  { href: projectsPath(locale), label: t.nav.portfolio },
  { href: pricingPath(locale), label: t.nav.pricing },
  { href: estimatePath(locale), label: t.nav.estimate },
  { href: demoPath(locale), label: t.nav.demo },
  { href: blogIndexPath(locale), label: t.nav.blog },
  { href: contactPath(locale, undefined, 'nav'), label: t.nav.contact },
];

/**
 * Which entry, if any, is the page being read.
 *
 * Compared on the path alone: the contact link carries `?via=nav`, and a
 * comparison that included the query would never match the page it points at.
 * Prefix rather than equality, so a single service page still lights up
 * "Services" — a reader deep in a section has not left it.
 */
const here = Astro.url.pathname.replace(/\/+$/, '');
const current = (href: string) => {
  const path = href.split(/[?#]/)[0]!.replace(/\/+$/, '');
  return here === path || here.startsWith(`${path}/`);
};
---

{/*
  Outside the header on purpose: the header is `position: fixed`, and an
  absolutely positioned child of a fixed element is anchored to the viewport,
  so a sentinel in there would never scroll out of view. See `.scroll-sentinel`
  in the stylesheet for what it replaces.
*/}
<div class="scroll-sentinel scroll-sentinel-header" data-header-sentinel aria-hidden="true"></div>

<header
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
  data-header
>
  <div
    class="border-b border-transparent transition-all duration-300 data-[scrolled]:border-border data-[scrolled]:bg-surface/80 data-[scrolled]:backdrop-blur-xl"
    data-header-bar
  >
    <div class="container-page flex h-16 items-center justify-between gap-4 md:h-18">
      <a
        href={home}
        class="group flex items-center gap-2.5 font-display text-base font-semibold tracking-tight"
      >
        <span
          class="grid size-8 place-items-center rounded-lg bg-linear-110 from-accent to-accent-alt text-on-accent"
        >
          <Icon name="spark" class="size-4" />
        </span>
        <span class="text-fg">{site.name}</span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label={t.nav.ariaPrimary}>
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={current(link.href) ? 'page' : undefined}
              class="rounded-lg px-3 py-2 text-sm font-medium text-fg-muted transition-colors hover:bg-surface-hover hover:text-fg aria-[current]:bg-surface-hover aria-[current]:text-fg"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <ThemeToggle locale={locale} class="hidden sm:grid" />
        <LanguageSwitcher locale={locale} class="hidden sm:flex" />
        <a href={contactPath(locale, undefined, 'nav')} class="btn btn-primary hidden text-sm sm:inline-flex">
          {t.nav.cta}
        </a>

        <button
          type="button"
          class="grid size-10 place-items-center rounded-lg border border-border text-fg-muted transition-colors hover:text-fg lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t.nav.menuOpen}
          data-menu-toggle
          data-label-open={t.nav.menuOpen}
          data-label-close={t.nav.menuClose}
        >
          <Icon name="menu" class="size-5" data-menu-icon-open />
          <Icon name="close" class="hidden size-5" data-menu-icon-close />
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-b border-border bg-surface/95 backdrop-blur-xl lg:hidden"
    data-mobile-menu
  >
    <nav class="container-page flex flex-col gap-1 py-4" aria-label={t.nav.ariaMobile}>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={current(link.href) ? 'page' : undefined}
            class="rounded-lg px-3 py-2.5 text-base font-medium text-fg-muted transition-colors hover:bg-surface-hover hover:text-fg aria-[current]:bg-surface-hover aria-[current]:text-fg"
            data-menu-link
          >
            {link.label}
          </a>
        ))
      }
      <div class="mt-3 flex items-center justify-between gap-3 border-t border-border pt-4">
        <div class="flex items-center gap-2">
          <ThemeToggle locale={locale} />
          <LanguageSwitcher locale={locale} />
        </div>
        <a href={contactPath(locale, undefined, 'nav')} class="btn btn-primary text-sm" data-menu-link>
          {t.nav.cta}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // --- Condense the header once the reader scrolls past the hero fold ---
  //
  // Watched rather than measured. Asking `window.scrollY` forces a layout, and
  // this script runs before the first paint, so that one question used to pull
  // the whole page's first layout into it. The sentinel is 12px tall and sits at
  // the top of the document: the moment it leaves the viewport, the reader has
  // scrolled past 12px — the same threshold, answered for free.
  const bar = document.querySelector<HTMLElement>('[data-header-bar]');
  const sentinel = document.querySelector('[data-header-sentinel]');

  if (bar && sentinel) {
    new IntersectionObserver(([entry]) => {
      bar.toggleAttribute('data-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }

  // --- Mobile menu ---
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const iconOpen = document.querySelector<SVGElement>('[data-menu-icon-open]');
  const iconClose = document.querySelector<SVGElement>('[data-menu-icon-close]');

  if (toggle && menu && iconOpen && iconClose) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute('aria-label', label);
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });

    // Tapping a link navigates within the page, so close the menu behind it.
    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
