---
/**
 * The full landing page. Both locale routes render this with a different
 * `locale`, so the two languages can never drift apart structurally.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './sections/Hero.astro';
import Services from './sections/Services.astro';
import Process from './sections/Process.astro';
import Comparison from './sections/Comparison.astro';
import Portfolio from './sections/Portfolio.astro';
import Testimonials from './sections/Testimonials.astro';
import Pricing from './sections/Pricing.astro';
import Configurator from './sections/Configurator.astro';
import Audit from './sections/Audit.astro';
import Contact from './sections/Contact.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Header locale={locale} />

  <main id="main">
    <Hero locale={locale} />
    <Services locale={locale} />
    <Process locale={locale} />
    {/* Objection handling before the proof, so the price list lands on a convinced reader. */}
    <Comparison locale={locale} />
    <Portfolio locale={locale} />
    <Testimonials locale={locale} />
    <Pricing locale={locale} />
    <Configurator locale={locale} />
    <Audit locale={locale} />
    <Contact locale={locale} />
  </main>

  <Footer locale={locale} />
</Base>
