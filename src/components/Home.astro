---
/**
 * The full landing page. Both locale routes render this with a different
 * `locale`, so the two languages can never drift apart structurally.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './sections/Hero.astro';
import LiveMetrics from './sections/LiveMetrics.astro';
import Services from './sections/Services.astro';
import Process from './sections/Process.astro';
import Comparison from './sections/Comparison.astro';
import Portfolio from './sections/Portfolio.astro';
import Guarantees from './sections/Guarantees.astro';
import About from './sections/About.astro';
import Testimonials from './sections/Testimonials.astro';
import Pricing from './sections/Pricing.astro';
import Configurator from './sections/Configurator.astro';
import Audit from './sections/Audit.astro';
import HomeFaq from './sections/HomeFaq.astro';
import Contact from './sections/Contact.astro';
import { getContent, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);

/**
 * The landing page's own questions, in the form search engines read. Emitted as
 * a separate block from the business entity rather than folded into it — two
 * documents describing two different things.
 *
 * Built as an object and serialised, because the answers contain both „…" and
 * "…" quotes and a hand-written JSON string would break on them.
 */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.homeFaq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Base locale={locale} extraSchema={faqSchema}>
  <Header locale={locale} />

  <main id="main">
    <Hero locale={locale} />
    {/* Directly under the hero's "95+ Lighthouse" claim, so the proof sits next to it. */}
    <LiveMetrics locale={locale} />
    <Services locale={locale} />
    <Process locale={locale} />
    {/* Objection handling before the proof, so the price list lands on a convinced reader. */}
    <Comparison locale={locale} />
    <Portfolio locale={locale} />
    <Guarantees locale={locale} />
    {/* Directly after the promises: who is making them. */}
    <About locale={locale} />
    {/* Renders nothing until a real testimonial exists — it self-checks. */}
    <Testimonials locale={locale} />
    <Pricing locale={locale} />
    <Configurator locale={locale} />
    <Audit locale={locale} />
    {/* Last objections before the form — answers only, no new promises. */}
    <HomeFaq locale={locale} />
    <Contact locale={locale} />
  </main>

  <Footer locale={locale} blueprint />
</Base>
