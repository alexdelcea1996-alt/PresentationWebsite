---
/**
 * Cloudflare serves this one file for every missing address, in either
 * language, so it carries both. Romanian leads because it is the default
 * locale; English gets a short line rather than a mirror of the whole page.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getContent, sectionIds } from '../i18n';
import { blogIndexPath } from '../data/blog';

const t = getContent('ro');
const en = getContent('en');
const home = getRelativeLocaleUrl('ro');

const links = [
  { href: `${home}#${sectionIds.services}`, label: t.nav.services },
  { href: `${home}#${sectionIds.pricing}`, label: t.nav.pricing },
  { href: blogIndexPath('ro'), label: t.nav.blog },
  { href: `${home}#${sectionIds.contact}`, label: t.nav.contact },
];
---

<Base locale="ro" title={t.notFound.metaTitle} description={t.notFound.body} noindex>
  <Header locale="ro" />

  <main id="main" class="relative overflow-hidden">
    <div
      class="glow left-1/2 top-[-6rem] size-[32rem] -translate-x-1/2 bg-accent/18"
      aria-hidden="true"
    >
    </div>

    <div class="container-page flex min-h-[70vh] flex-col justify-center py-24">
      <div class="mx-auto max-w-xl text-center">
        <p class="font-display text-7xl font-semibold text-gradient sm:text-8xl">
          {t.notFound.code}
        </p>
        <h1 class="mt-6 font-display text-3xl font-semibold sm:text-4xl">{t.notFound.title}</h1>
        <p class="mt-5 text-base leading-relaxed text-fg-muted">{t.notFound.body}</p>

        <a href={home} class="btn btn-primary mt-8">
          {t.notFound.home}
          <Icon name="arrow-right" class="size-4" />
        </a>

        <div class="mt-12 border-t border-border pt-8">
          <p class="text-xs uppercase tracking-[0.18em] text-fg-subtle">
            {t.notFound.linksTitle}
          </p>
          <ul class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-2">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-fg-muted underline underline-offset-4 transition-colors hover:text-accent-alt"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <p class="mt-8 text-sm text-fg-subtle" lang="en">
          {en.notFound.title}.{' '}
          <a
            href={getRelativeLocaleUrl('en')}
            class="underline underline-offset-4 transition-colors hover:text-accent-alt"
          >
            {en.notFound.home}
          </a>
        </p>
      </div>
    </div>
  </main>

  <Footer locale="ro" />
</Base>
